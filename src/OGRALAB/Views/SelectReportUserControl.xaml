<UserControl x:Class="OGRALAB.Views.SelectReportUserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:converters="clr-namespace:OGRALAB.Converters"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="1000"
             FlowDirection="RightToLeft"
             FontFamily="Segoe UI"
             FontSize="14"
             Background="{DynamicResource WindowBackground}">
    <UserControl.Resources>
        <!-- Converters -->
        <converters:BooleanToStatusTextConverter x:Key="BooleanToStatusTextConverter"/>
        <converters:BooleanToStatusColorConverter x:Key="BooleanToStatusColorConverter"/>
        <converters:AbnormalResultColorConverter x:Key="AbnormalResultColorConverter"/>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>

        <!-- Styles -->
        <Style x:Key="SectionHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#FF2C5282"/>
            <Setter Property="Margin" Value="0,0,0,15"/>
        </Style>
        <Style x:Key="ModernButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#FF2C5282"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="20,10"/>
            <Setter Property="Margin" Value="10,5"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="MinWidth" Value="120"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="6"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                BorderBrush="{TemplateBinding BorderBrush}">
                            <ContentPresenter HorizontalAlignment="Center" 
                                            VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#FF38A169"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#FF2A5170"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Background" Value="#FFCCCCCC"/>
                                <Setter Property="Foreground" Value="#FF666666"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="RefreshButtonStyle" TargetType="Button" BasedOn="{StaticResource ModernButtonStyle}">
            <Setter Property="Background" Value="#FF9C27B0"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FFBA68C8"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="TestItemBorderStyle" TargetType="Border">
            <Setter Property="BorderBrush" Value="#FFDDDDDD"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Margin" Value="0,3"/>
            <Setter Property="Padding" Value="15,10"/>
            <Setter Property="Background" Value="White"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="#FF2C5282"/>
                    <Setter Property="Background" Value="#FFF8F9FA"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- العنوان -->
            <RowDefinition Height="Auto"/>
            <!-- اختيار المريض -->
            <RowDefinition Height="*"/>
            <!-- قائمة الفحوصات -->
            <RowDefinition Height="Auto"/>
            <!-- رسالة الحالة -->
            <RowDefinition Height="Auto"/>
            <!-- الأزرار -->
        </Grid.RowDefinitions>
        <!-- العنوان -->
        <TextBlock Grid.Row="0" 
                   Text="📊 معاينة وطباعة التقارير" 
                   Style="{StaticResource SectionHeaderStyle}"
                   HorizontalAlignment="Center" 
                   Margin="0,0,0,25"/>
        <!-- اختيار المريض -->
        <GroupBox Grid.Row="1" 
                  Header="اختيار المريض" 
                  Padding="20" 
                  Margin="0,0,0,20"
                  FontSize="14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" 
                           Text="اختر المريض:" 
                           Margin="0,0,0,8"
                           FontWeight="SemiBold"/>

                <ComboBox Grid.Row="1" 
                          ItemsSource="{Binding Patients}"
                          SelectedItem="{Binding SelectedPatient}"
                          DisplayMemberPath="DisplayText"
                          Height="40"
                          FontSize="14"
                          IsEnabled="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=inverse}">
                    <ComboBox.Style>
                        <Style TargetType="ComboBox">
                            <Setter Property="Background" Value="White"/>
                            <Setter Property="BorderBrush" Value="#FFCCCCCC"/>
                            <Setter Property="BorderThickness" Value="1"/>
                            <Setter Property="Padding" Value="10"/>
                            <Style.Triggers>
                                <Trigger Property="IsFocused" Value="True">
                                    <Setter Property="BorderBrush" Value="#FF2C5282"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </ComboBox.Style>
                </ComboBox>
            </Grid>
        </GroupBox>
        <!-- قائمة الفحوصات -->
        <GroupBox Grid.Row="2" 
                  Header="الفحوصات المطلوبة" 
                  Padding="20"
                  FontSize="14"
                  Visibility="{Binding SelectedPatient, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <!-- ملخص الفحوصات -->
                <TextBlock Grid.Row="0" 
                           FontWeight="SemiBold"
                           Foreground="#FF38A169"
                           Margin="0,0,0,10">
                    <TextBlock.Text>
                        <MultiBinding StringFormat="الفحوصات المكتملة: {0} من {1}">
                            <Binding Path="SelectedPatient.CompletedTestsCount"/>
                            <Binding Path="SelectedPatient.TotalTestsCount"/>
                        </MultiBinding>
                    </TextBlock.Text>
                </TextBlock>
                <!-- قائمة الفحوصات -->
                <ScrollViewer Grid.Row="1" 
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding SelectedPatient.AvailableTests}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource TestItemBorderStyle}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <!-- CheckBox -->
                                        <CheckBox Grid.Column="0" 
                                                  IsChecked="{Binding IsSelected}"
                                                  IsEnabled="{Binding CanBeSelected}"
                                                  VerticalAlignment="Center" 
                                                  Margin="0,0,15,0">
                                            <CheckBox.Style>
                                                <Style TargetType="CheckBox">
                                                    <Setter Property="Foreground" Value="#FF2C5282"/>
                                                    <Style.Triggers>
                                                        <Trigger Property="IsEnabled" Value="False">
                                                            <Setter Property="Foreground" Value="#FFCCCCCC"/>
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </CheckBox.Style>
                                        </CheckBox>
                                        <!-- معلومات الفحص -->
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding TestName}" 
                                                       FontWeight="SemiBold"
                                                       FontSize="14"/>
                                            <TextBlock Text="{Binding FormattedResult}" 
                                                       Foreground="{Binding IsAbnormal, Converter={StaticResource AbnormalResultColorConverter}}"
                                                       FontSize="12" 
                                                       Margin="0,3,0,0"
                                                       Visibility="{Binding HasResult, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsAbnormal}" Value="True">
                                                                <Setter Property="FontWeight" Value="Bold"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <TextBlock Foreground="#FF718096"
                                                       FontSize="11" 
                                                       Margin="0,2,0,0"
                                                       Visibility="{Binding HasResult, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                <TextBlock.Text>
                                                    <Binding Path="ReferenceRange" StringFormat="المدى المرجعي: {0}"/>
                                                </TextBlock.Text>
                                            </TextBlock>
                                        </StackPanel>
                                        <!-- حالة الفحص -->
                                        <TextBlock Grid.Column="2" 
                                                   Text="{Binding HasResult, Converter={StaticResource BooleanToStatusTextConverter}}"
                                                   Foreground="{Binding HasResult, Converter={StaticResource BooleanToStatusColorConverter}}"
                                                   VerticalAlignment="Center"
                                                   FontSize="12"
                                                   FontWeight="SemiBold"
                                                   Margin="10,0"/>
                                        <!-- رمز تحذير للنتائج غير الطبيعية -->
                                        <TextBlock Grid.Column="3" 
                                                   Text="⚠️"
                                                   VerticalAlignment="Center"
                                                   FontSize="16"
                                                   Margin="5,0,0,0"
                                                   Visibility="{Binding IsAbnormal, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </GroupBox>
        <!-- رسالة الحالة -->
        <Border Grid.Row="3" 
                Background="#FFF0F8FF" 
                BorderBrush="#FF2C5282" 
                BorderThickness="1" 
                CornerRadius="4" 
                Padding="15,8" 
                Margin="0,10"
                Visibility="{Binding StatusMessage, Converter={StaticResource BooleanToVisibilityConverter}}">
            <TextBlock Text="{Binding StatusMessage}" 
                       Foreground="#FF2C5282" 
                       FontWeight="SemiBold"
                       HorizontalAlignment="Center"/>
        </Border>
        <!-- الأزرار -->
        <StackPanel Grid.Row="4" 
                    Orientation="Horizontal" 
                    HorizontalAlignment="Center" 
                    Margin="0,20,0,0">
            <Button Content="📋 معاينة التقرير" 
                    Command="{Binding PreviewReportCommand}"
                    Style="{StaticResource ModernButtonStyle}"/>
            <Button Content="🔄 تحديث" 
                    Command="{Binding RefreshCommand}"
                    Style="{StaticResource RefreshButtonStyle}"/>
        </StackPanel>
        <!-- مؤشر التحميل -->
        <Grid Grid.RowSpan="5" 
              Background="#80000000" 
              Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <ProgressBar IsIndeterminate="True" 
                             Height="4" 
                             Width="250" 
                             Margin="0,0,0,15"/>
                <TextBlock Text="جاري التحميل..." 
                           Foreground="White" 
                           HorizontalAlignment="Center"
                           FontSize="16"
                           FontWeight="SemiBold"/>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>