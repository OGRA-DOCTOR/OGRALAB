<Window x:Class="OGRALAB.Views.AddPatientWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:enums="clr-namespace:OGRALAB.Enums"
        mc:Ignorable="d"
        Title="إضافة مريض جديد - OGRALAB"
        Height="900" Width="1200"
        WindowStartupLocation="CenterOwner"
        FlowDirection="RightToLeft"
        FontFamily="Segoe UI"
        FontSize="14">

    <Window.Resources>
        <Style TargetType="GroupBox">
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="BorderBrush" Value="#CCCCCC"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        
        <Style TargetType="Label">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontWeight" Value="Normal"/>
        </Style>
        
        <Style TargetType="TextBox">
            <Setter Property="Height" Value="30"/>
            <Setter Property="Padding" Value="5,2"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="BorderBrush" Value="#CCCCCC"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        
        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="30"/>
            <Setter Property="Padding" Value="5,2"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="BorderBrush" Value="#CCCCCC"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        
        <Style TargetType="Button">
            <Setter Property="Padding" Value="15,8"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#0078D4"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#0078D4"/>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#F3F2F1"/>
            <Setter Property="Foreground" Value="#323130"/>
            <Setter Property="BorderBrush" Value="#8A8886"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <Grid Margin="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- العمود الأيسر -->
                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                    
                    <!-- بيانات المريض الأساسية -->
                    <GroupBox Header="بيانات المريض الأساسية">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- كود المريض -->
                            <Label Grid.Row="0" Grid.Column="0" Content="كود المريض:"/>
                            <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding PatientCode}" IsReadOnly="True" 
                                     Background="#F5F5F5" FontWeight="Bold"/>

                            <!-- اللقب -->
                            <Label Grid.Row="1" Grid.Column="0" Content="اللقب:"/>
                            <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding AvailableTitles}" 
                                      SelectedItem="{Binding SelectedTitle}"/>

                            <!-- الاسم الكامل -->
                            <Label Grid.Row="2" Grid.Column="0" Content="الاسم الكامل:*"/>
                            <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding FullName}"/>

                            <!-- الجنس -->
                            <Label Grid.Row="3" Grid.Column="0" Content="الجنس:"/>
                            <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <RadioButton Content="Male" GroupName="Gender" Margin="0,0,20,0"/>
                                <RadioButton Content="Female" GroupName="Gender" Margin="0,0,20,0"/>
                                <RadioButton Content="Unknown" GroupName="Gender"/>
                            </StackPanel>

                            <!-- العمر -->
                            <Label Grid.Row="4" Grid.Column="0" Content="العمر:"/>
                            <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal">
                                <TextBox Width="80" Text="{Binding Age}" Margin="0,0,10,0"/>
                                <ComboBox Width="100" SelectedIndex="0">
                                    <ComboBoxItem Content="سنة"/>
                                    <ComboBoxItem Content="شهر"/>
                                    <ComboBoxItem Content="يوم"/>
                                </ComboBox>
                            </StackPanel>

                            <!-- رقم الموبايل -->
                            <Label Grid.Row="5" Grid.Column="0" Content="رقم الموبايل:"/>
                            <TextBox Grid.Row="5" Grid.Column="1" Text="{Binding MobileNumber}" MaxLength="11"/>
                        </Grid>
                    </GroupBox>

                    <!-- بيانات الطبيب والجهة -->
                    <GroupBox Header="بيانات الطبيب والجهة">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- چيك بوكس الطباعة -->
                            <CheckBox Grid.Row="0" Grid.ColumnSpan="2" Content="طباعة الفاتورة" 
                                      IsChecked="{Binding PrintInvoice}" Margin="0,0,0,10"/>

                            <!-- قائمة الأطباء -->
                            <Label Grid.Row="1" Grid.Column="0" Content="الطبيب:"/>
                            <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding Doctors}" 
                                      SelectedItem="{Binding SelectedDoctor}" DisplayMemberPath="FullName"
                                      IsEditable="True" IsTextSearchEnabled="True"/>

                            <!-- قائمة الجهات -->
                            <Label Grid.Row="2" Grid.Column="0" Content="الجهة/العيادة:"/>
                            <ComboBox Grid.Row="2" Grid.Column="1" ItemsSource="{Binding Entities}" 
                                      SelectedItem="{Binding SelectedEntity}" DisplayMemberPath="Name"
                                      IsEditable="True" IsTextSearchEnabled="True"/>
                        </Grid>
                    </GroupBox>

                    <!-- حساب التكلفة -->
                    <GroupBox Header="حساب التكلفة">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- إجمالي المبلغ -->
                            <Label Grid.Row="0" Grid.Column="0" Content="إجمالي المبلغ:"/>
                            <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding TotalAmount, StringFormat=N2}" 
                                     IsReadOnly="True" Background="#F5F5F5"/>
                            <Label Grid.Row="0" Grid.Column="2" Content="ريال"/>

                            <!-- نسبة الخصم -->
                            <Label Grid.Row="1" Grid.Column="0" Content="نسبة الخصم:"/>
                            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding DiscountPercentage}"/>
                            <Label Grid.Row="1" Grid.Column="2" Content="%"/>

                            <!-- قيمة الخصم -->
                            <Label Grid.Row="2" Grid.Column="0" Content="قيمة الخصم:"/>
                            <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding DiscountAmount, StringFormat=N2}" 
                                     IsReadOnly="True" Background="#F5F5F5"/>
                            <Label Grid.Row="2" Grid.Column="2" Content="ريال"/>

                            <!-- المبلغ بعد الخصم -->
                            <Label Grid.Row="3" Grid.Column="0" Content="المبلغ بعد الخصم:"/>
                            <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding AmountAfterDiscount, StringFormat=N2}" 
                                     IsReadOnly="True" Background="#F5F5F5" FontWeight="Bold"/>
                            <Label Grid.Row="3" Grid.Column="2" Content="ريال"/>

                            <!-- المدفوع مسبقاً -->
                            <Label Grid.Row="4" Grid.Column="0" Content="المدفوع مسبقاً:"/>
                            <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding PaidAmount}"/>
                            <Label Grid.Row="4" Grid.Column="2" Content="ريال"/>

                            <!-- المتبقي للتحصيل -->
                            <Label Grid.Row="5" Grid.Column="0" Content="المتبقي للتحصيل:"/>
                            <TextBox Grid.Row="5" Grid.Column="1" Text="{Binding RemainingAmount, StringFormat=N2}" 
                                     IsReadOnly="True" Background="#FFE6E6" FontWeight="Bold"/>
                            <Label Grid.Row="5" Grid.Column="2" Content="ريال"/>
                        </Grid>
                    </GroupBox>
                </StackPanel>

                <!-- العمود الأيمن -->
                <GroupBox Grid.Column="1" Header="اختيار الفحوصات" Margin="10,0,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="200"/>
                        </Grid.RowDefinitions>

                        <!-- بحث سريع -->
                        <TextBox Grid.Row="0" Text="{Binding TestSearchText, UpdateSourceTrigger=PropertyChanged}" 
                                 Margin="0,0,0,10">
                            <TextBox.Style>
                                <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                                    <Style.Triggers>
                                        <Trigger Property="Text" Value="">
                                            <Setter Property="Background">
                                                <Setter.Value>
                                                    <VisualBrush AlignmentX="Left" AlignmentY="Center" Stretch="None">
                                                        <VisualBrush.Visual>
                                                            <Label Content="البحث في الفحوصات..." Foreground="Gray"/>
                                                        </VisualBrush.Visual>
                                                    </VisualBrush>
                                                </Setter.Value>
                                            </Setter>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBox.Style>
                        </TextBox>

                        <!-- قائمة الفحوصات المتاحة -->
                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <ListBox Grid.Column="0" ItemsSource="{Binding FilteredAvailableTests}" 
                                     SelectedItem="{Binding SelectedAvailableTest}" Margin="0,0,5,0">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Vertical">
                                            <TextBlock Text="{Binding TestName}" FontWeight="Bold"/>
                                            <TextBlock Text="{Binding Category}" FontSize="12" Foreground="Gray"/>
                                            <TextBlock Text="{Binding Price, StringFormat='{}{0:N2} ريال'}" FontSize="12" Foreground="Blue"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <!-- أزرار التحكم -->
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="5,0,0,0">
                                <Button Content="إضافة" Command="{Binding AddTestCommand}" Style="{StaticResource PrimaryButton}"/>
                                <Button Content="حذف" Command="{Binding RemoveTestCommand}" Style="{StaticResource SecondaryButton}"/>
                                <Button Content="حذف الكل" Command="{Binding RemoveAllTestsCommand}" Style="{StaticResource SecondaryButton}"/>
                            </StackPanel>
                        </Grid>

                        <Separator Grid.Row="2" Margin="0,10"/>

                        <!-- قائمة الفحوصات المختارة -->
                        <Grid Grid.Row="3">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Label Grid.Row="0" Content="الفحوصات المختارة:" FontWeight="Bold"/>
                            
                            <ListBox Grid.Row="1" ItemsSource="{Binding SelectedTests}" 
                                     SelectedItem="{Binding SelectedTestForRemoval}" Background="#F9F9F9">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Orientation="Vertical">
                                                <TextBlock Text="{Binding TestName}" FontWeight="Bold"/>
                                                <TextBlock Text="{Binding Abbreviation}" FontSize="12" Foreground="Gray"/>
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Text="{Binding Price, StringFormat='{}{0:N2} ريال'}" 
                                                       FontWeight="Bold" Foreground="Blue" VerticalAlignment="Center"/>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Grid>
                </GroupBox>
            </Grid>
        </ScrollViewer>

        <!-- شريط الحالة والأزرار -->
        <Grid Grid.Row="1" Background="#F5F5F5">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- رسائل الحالة -->
            <StackPanel Grid.Row="0" Margin="10,5">
                <TextBlock Text="{Binding ErrorMessage}" Foreground="Red" 
                           Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibilityConverter}}"/>
                <TextBlock Text="{Binding SuccessMessage}" Foreground="Green" 
                           Visibility="{Binding SuccessMessage, Converter={StaticResource StringToVisibilityConverter}}"/>
            </StackPanel>

            <!-- الأزرار -->
            <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Left" Margin="10,5,10,10">
                <Button Content="حفظ" Command="{Binding SavePatientCommand}" Style="{StaticResource PrimaryButton}"/>
                <Button Content="إلغاء" Command="{Binding CancelCommand}" Style="{StaticResource SecondaryButton}"/>
            </StackPanel>

            <!-- مؤشر التحميل -->
            <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" 
                        VerticalAlignment="Center" Margin="10,5,10,10"
                        Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}">
                <ProgressBar IsIndeterminate="True" Width="100" Height="20" Margin="0,0,10,0"/>
                <TextBlock Text="جاري المعالجة..." VerticalAlignment="Center"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
