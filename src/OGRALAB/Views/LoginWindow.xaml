<Window x:Class="OGRALAB.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OGRALAB - Login"
        Height="550"
        Width="400"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#F8F9FA"
        Icon="../Images/ogralab_logo.png">

    <Window.Resources>
        <!-- Color Resources -->
        <SolidColorBrush x:Key="PrimaryColor" Color="#1B4D3E"/>
        <SolidColorBrush x:Key="SecondaryColor" Color="#2E7D68"/>
        <SolidColorBrush x:Key="AccentColor" Color="#4A9F8A"/>
        <SolidColorBrush x:Key="LightBlue" Color="#E8F4F8"/>
        <SolidColorBrush x:Key="DarkGray" Color="#333333"/>
        <SolidColorBrush x:Key="LightGray" Color="#F0F0F0"/>
        <SolidColorBrush x:Key="BorderColor" Color="#CCCCCC"/>
        <SolidColorBrush x:Key="ErrorColor" Color="#DC3545"/>
        <SolidColorBrush x:Key="SuccessColor" Color="#28A745"/>

        <!-- Button Styles -->
        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource PrimaryColor}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="15,8"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="5"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center"
                                            VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{StaticResource SecondaryColor}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="{StaticResource AccentColor}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Background" Value="{StaticResource LightGray}"/>
                                <Setter Property="Foreground" Value="{StaticResource DarkGray}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource DarkGray}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/>
            <Setter Property="Padding" Value="15,8"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="5"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center"
                                            VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{StaticResource LightGray}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- TextBox Styles -->
        <Style x:Key="ModernTextBoxStyle" TargetType="TextBox">
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5">
                            <ScrollViewer x:Name="PART_ContentHost"
                                        Margin="{TemplateBinding Padding}"
                                        VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter Property="BorderBrush" Value="{StaticResource PrimaryColor}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- PasswordBox Style -->
        <Style x:Key="ModernPasswordBoxStyle" TargetType="PasswordBox">
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5">
                            <ScrollViewer x:Name="PART_ContentHost"
                                        Margin="{TemplateBinding Padding}"
                                        VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter Property="BorderBrush" Value="{StaticResource PrimaryColor}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ComboBox Style -->
        <Style x:Key="ModernComboBoxStyle" TargetType="ComboBox">
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Background" Value="White"/>
        </Style>
    </Window.Resources>

    <Grid>
        <!-- Main Container -->
        <Border Background="White"
                CornerRadius="10"
                Margin="20"
                Padding="30">
            <Border.Effect>
                <DropShadowEffect Color="Gray" 
                                Direction="270" 
                                ShadowDepth="5" 
                                BlurRadius="10" 
                                Opacity="0.3"/>
            </Border.Effect>

            <StackPanel>
                <!-- Logo and Title -->
                <StackPanel HorizontalAlignment="Center" Margin="0,0,0,30">
                    <Image Source="../Images/ogralab_logo.png"
                           Height="80"
                           Width="80"
                           Margin="0,0,0,15"/>
                    <TextBlock Text="OGRALAB"
                               FontSize="28"
                               FontWeight="Bold"
                               Foreground="{StaticResource PrimaryColor}"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="Medical Laboratory Management System"
                               FontSize="12"
                               Foreground="{StaticResource DarkGray}"
                               HorizontalAlignment="Center"
                               Margin="0,5,0,0"/>
                </StackPanel>

                <!-- Login Form -->
                <StackPanel>
                    <!-- Username Field -->
                    <StackPanel Margin="0,0,0,15">
                        <TextBlock Text="Username"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource DarkGray}"
                                   Margin="0,0,0,5"/>
                        <ComboBox Name="UsernameComboBox"
                                  Style="{StaticResource ModernComboBoxStyle}"
                                  IsEditable="True"
                                  Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"
                                  SelectedItem="{Binding SelectedUsername}"
                                  ItemsSource="{Binding RecentUsernames}"/>
                    </StackPanel>

                    <!-- Password Field -->
                    <StackPanel Margin="0,0,0,15">
                        <TextBlock Text="Password"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource DarkGray}"
                                   Margin="0,0,0,5"/>
                        <Grid>
                            <PasswordBox Name="PasswordBox"
                                         Style="{StaticResource ModernPasswordBoxStyle}"/>
                            <TextBox Name="PasswordTextBox"
                                     Style="{StaticResource ModernTextBoxStyle}"
                                     Text="{Binding Password, UpdateSourceTrigger=PropertyChanged}"
                                     Visibility="Collapsed"
                                     TextChanged="PasswordTextBox_TextChanged"/>
                            <Button Content="👁"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Margin="0,0,10,0"
                                    FontSize="16"
                                    Command="{Binding TogglePasswordVisibilityCommand}"
                                    Cursor="Hand"/>
                        </Grid>
                    </StackPanel>

                    <!-- Options -->
                    <Grid Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <CheckBox Grid.Column="0" 
                                  Content="Show Password"
                                  IsChecked="{Binding IsPasswordVisible}"
                                  Foreground="{StaticResource DarkGray}"
                                  HorizontalAlignment="Left"/>
                        <CheckBox Grid.Column="1" 
                                  Content="Remember Me"
                                  IsChecked="{Binding RememberMe}"
                                  Foreground="{StaticResource DarkGray}"
                                  HorizontalAlignment="Right"/>
                    </Grid>

                    <!-- Status Message -->
                    <TextBlock Name="StatusMessageBlock"
                               Text="{Binding StatusMessage}"
                               HorizontalAlignment="Center"
                               Foreground="{StaticResource ErrorColor}"
                               FontWeight="SemiBold"
                               Margin="0,0,0,15"
                               Visibility="Collapsed"/>

                    <!-- Buttons -->
                    <StackPanel Orientation="Horizontal" 
                                HorizontalAlignment="Center"
                                Margin="0,10,0,0">
                        <Button Content="Login"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Command="{Binding LoginCommand}"
                                IsDefault="True"
                                MinWidth="100"
                                Margin="0,0,10,0"/>
                        <Button Content="Exit"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Command="{Binding ExitCommand}"
                                MinWidth="100"/>
                    </StackPanel>

                    <!-- Loading Indicator -->
                    <ProgressBar Name="LoadingProgressBar"
                                 IsIndeterminate="True"
                                 Height="4"
                                 Margin="0,15,0,0"
                                 Foreground="{StaticResource PrimaryColor}"
                                 Visibility="Collapsed"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>