<Window x:Class="OGRALAB.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OGRALAB - Login"
        Height="650"
        Width="500"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        WindowStyle="None"
        Background="Transparent"
        Icon="../Images/ogralab_logo.png">

    <Window.Resources>
        <!-- Enhanced Color Palette -->
        <SolidColorBrush x:Key="PrimaryColor" Color="#2C5282"/>
        <!-- Deep Blue -->
        <SolidColorBrush x:Key="SecondaryColor" Color="#38A169"/>
        <!-- Green -->
        <SolidColorBrush x:Key="AccentColor" Color="#E53E3E"/>
        <!-- Red -->
        <SolidColorBrush x:Key="BackgroundColor" Color="#F7FAFC"/>
        <!-- Light Gray -->
        <SolidColorBrush x:Key="SurfaceColor" Color="#FFFFFF"/>
        <!-- Pure White -->

        <!-- New Enhanced Colors -->
        <SolidColorBrush x:Key="LoginButtonColor" Color="#28A745"/>
        <!-- Green for Login -->
        <SolidColorBrush x:Key="ExitButtonColor" Color="#FF8C00"/>
        <!-- Orange for Exit -->
        <SolidColorBrush x:Key="WelcomeTextColor" Color="#4A90E2"/>
        <!-- Light Blue for Welcome -->
        <SolidColorBrush x:Key="SubtitleColor" Color="#7B68EE"/>
        <!-- Medium Slate Blue -->

        <!-- Supporting Colors -->
        <SolidColorBrush x:Key="TextPrimary" Color="#2D3748"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#718096"/>
        <SolidColorBrush x:Key="BorderColor" Color="#E2E8F0"/>
        <SolidColorBrush x:Key="HoverColor" Color="#EDF2F7"/>
        <SolidColorBrush x:Key="SuccessColor" Color="#38A169"/>
        <SolidColorBrush x:Key="ErrorColor" Color="#E53E3E"/>

        <!-- Gradient Brushes -->
        <LinearGradientBrush x:Key="HeaderGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#2C5282" Offset="0"/>
            <GradientStop Color="#38A169" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="BackgroundGradient" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#F7FAFC" Offset="0"/>
            <GradientStop Color="#EDF2F7" Offset="1"/>
        </LinearGradientBrush>

        <!-- Enhanced Login Button Style -->
        <Style x:Key="LoginButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource LoginButtonColor}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="25,15"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="10"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <Border.Effect>
                                <DropShadowEffect Color="#28A745" 
                                                Direction="270" 
                                                ShadowDepth="3" 
                                                BlurRadius="10" 
                                                Opacity="0.4"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center"
                                            VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#34CE57"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#1E7E34"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Background" Value="{StaticResource TextSecondary}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Enhanced Exit Button Style -->
        <Style x:Key="ExitButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource ExitButtonColor}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="25,15"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="10"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <Border.Effect>
                                <DropShadowEffect Color="#FF8C00" 
                                                Direction="270" 
                                                ShadowDepth="3" 
                                                BlurRadius="10" 
                                                Opacity="0.4"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center"
                                            VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#FFA500"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#CC7000"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Enhanced TextBox Style with Fixed Height -->
        <Style x:Key="ModernTextBoxStyle" TargetType="TextBox">
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/>
            <Setter Property="Padding" Value="15,12"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Height" Value="45"/>
            <Setter Property="Background" Value="{StaticResource SurfaceColor}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost"
                                        Margin="{TemplateBinding Padding}"
                                        VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter Property="BorderBrush" Value="{StaticResource PrimaryColor}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="BorderBrush" Value="{StaticResource SecondaryColor}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Enhanced PasswordBox Style with Fixed Height -->
        <Style x:Key="ModernPasswordBoxStyle" TargetType="PasswordBox">
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/>
            <Setter Property="Padding" Value="15,12"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Height" Value="45"/>
            <Setter Property="Background" Value="{StaticResource SurfaceColor}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost"
                                        Margin="{TemplateBinding Padding}"
                                        VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter Property="BorderBrush" Value="{StaticResource PrimaryColor}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="BorderBrush" Value="{StaticResource SecondaryColor}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Enhanced ComboBox Style with Fixed Height -->
        <Style x:Key="ModernComboBoxStyle" TargetType="ComboBox">
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/>
            <Setter Property="Padding" Value="15,12"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Height" Value="45"/>
            <Setter Property="Background" Value="{StaticResource SurfaceColor}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <Grid>
                                <ToggleButton Name="ToggleButton"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            IsChecked="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                            ClickMode="Press"/>
                                <ContentPresenter Name="ContentSite"
                                                IsHitTestVisible="False"
                                                Content="{TemplateBinding SelectionBoxItem}"
                                                ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                                Margin="{TemplateBinding Padding}"
                                                VerticalAlignment="Center"
                                                HorizontalAlignment="Left"/>
                                <TextBox x:Name="PART_EditableTextBox"
                                        Style="{x:Null}"
                                        Background="Transparent"
                                        Visibility="Hidden"
                                        IsReadOnly="{TemplateBinding IsReadOnly}"/>
                                <Popup Name="Popup"
                                    Placement="Bottom"
                                    IsOpen="{TemplateBinding IsDropDownOpen}"
                                    AllowsTransparency="True"
                                    Focusable="False"
                                    PopupAnimation="Slide">
                                    <Grid Name="DropDown"
                                        SnapsToDevicePixels="True"
                                        MinWidth="{TemplateBinding ActualWidth}"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                        <Border x:Name="DropDownBorder"
                                                Background="{StaticResource SurfaceColor}"
                                                BorderThickness="2"
                                                BorderBrush="{StaticResource BorderColor}"
                                                CornerRadius="8"/>
                                        <ScrollViewer Margin="4,6,4,6" SnapsToDevicePixels="True">
                                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained"/>
                                        </ScrollViewer>
                                    </Grid>
                                </Popup>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter Property="BorderBrush" Value="{StaticResource PrimaryColor}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="BorderBrush" Value="{StaticResource SecondaryColor}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Enhanced CheckBox Style with Larger Font -->
        <Style x:Key="ModernCheckBoxStyle" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <!-- Eye Button Style -->
        <Style x:Key="EyeButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center"
                                            VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{StaticResource HoverColor}"/>
                                <Setter Property="Foreground" Value="{StaticResource PrimaryColor}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Enhanced Field Label Style -->
        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Foreground" Value="{StaticResource PrimaryColor}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <!-- Main Container with Background Gradient -->
    <Border Background="{StaticResource BackgroundGradient}"
            CornerRadius="15">
        <Border.Effect>
            <DropShadowEffect Color="Black" 
                            Direction="270" 
                            ShadowDepth="10" 
                            BlurRadius="20" 
                            Opacity="0.3"/>
        </Border.Effect>

        <Grid>
            <!-- Header Section with Gradient -->
            <Border Background="{StaticResource HeaderGradient}"
                    CornerRadius="15,15,0,0"
                    Height="140"
                    VerticalAlignment="Top">
                <Grid>
                    <!-- Close Button -->
                    <Button Content="✕"
                            Style="{StaticResource EyeButtonStyle}"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Width="30"
                            Height="30"
                            Margin="15,15,15,0"
                            Foreground="White"
                            FontSize="14"
                            Command="{Binding ExitCommand}"/>

                    <!-- Logo and Title -->
                    <StackPanel HorizontalAlignment="Center" 
                                VerticalAlignment="Center">
                        <Image Source="../Images/ogralab_logo.png"
                               Height="80"
                               Width="80"
                               Margin="0,0,0,12">
                            <Image.Effect>
                                <DropShadowEffect Color="White" 
                                                ShadowDepth="0" 
                                                BlurRadius="15" 
                                                Opacity="0.4"/>
                            </Image.Effect>
                        </Image>
                        <TextBlock Text="OGRALAB"
                                   FontSize="26"
                                   FontWeight="Bold"
                                   Foreground="White"
                                   HorizontalAlignment="Center">
                            <TextBlock.Effect>
                                <DropShadowEffect Color="Black" 
                                                ShadowDepth="2" 
                                                BlurRadius="4" 
                                                Opacity="0.3"/>
                            </TextBlock.Effect>
                        </TextBlock>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Main Content -->
            <Border Background="{StaticResource SurfaceColor}"
                    CornerRadius="0,0,15,15"
                    Margin="0,140,0,0"
                    Padding="40,30,40,40">

                <StackPanel>
                    <!-- Welcome Message -->
                    <StackPanel HorizontalAlignment="Center" Margin="0,0,0,30">
                        <TextBlock Text="Welcome Back!"
                                   FontSize="28"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource WelcomeTextColor}"
                                   HorizontalAlignment="Center">
                            <TextBlock.Effect>
                                <DropShadowEffect Color="{Binding Source={StaticResource WelcomeTextColor}, Path=Color}" 
                                                ShadowDepth="1" 
                                                BlurRadius="3" 
                                                Opacity="0.3"/>
                            </TextBlock.Effect>
                        </TextBlock>
                        <TextBlock Text="Medical Laboratory Management System"
                                   FontSize="16"
                                   FontWeight="Medium"
                                   Foreground="{StaticResource SubtitleColor}"
                                   HorizontalAlignment="Center"
                                   Margin="0,8,0,0"/>
                    </StackPanel>

                    <!-- Login Form -->
                    <StackPanel>
                        <!-- Username Field -->
                        <Grid Margin="0,0,0,20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Text="Username:"
                                       Style="{StaticResource FieldLabelStyle}"
                                       Margin="0,0,15,0"/>
                            <ComboBox Grid.Column="1"
                                      Name="UsernameComboBox"
                                      Style="{StaticResource ModernComboBoxStyle}"
                                      IsEditable="True"
                                      Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"
                                      SelectedItem="{Binding SelectedUsername}"
                                      ItemsSource="{Binding RecentUsernames}"/>
                        </Grid>

                        <!-- Password Field -->
                        <Grid Margin="0,0,0,25">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Text="Password:"
                                       Style="{StaticResource FieldLabelStyle}"
                                       Margin="0,0,15,0"/>
                            <Grid Grid.Column="1">
                                <PasswordBox Name="PasswordBox"
                                             Style="{StaticResource ModernPasswordBoxStyle}"/>
                                <TextBox Name="PasswordTextBox"
                                         Style="{StaticResource ModernTextBoxStyle}"
                                         Text="{Binding Password, UpdateSourceTrigger=PropertyChanged}"
                                         Visibility="Collapsed"
                                         TextChanged="PasswordTextBox_TextChanged"/>
                                <Button Content="👁"
                                        Style="{StaticResource EyeButtonStyle}"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        Margin="0,0,15,0"
                                        Command="{Binding TogglePasswordVisibilityCommand}"/>
                            </Grid>
                        </Grid>

                        <!-- Options -->
                        <Grid Margin="0,0,0,30">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <CheckBox Grid.Column="0" 
                                      Content="Show Password"
                                      Style="{StaticResource ModernCheckBoxStyle}"
                                      IsChecked="{Binding IsPasswordVisible}"
                                      HorizontalAlignment="Left"/>
                            <CheckBox Grid.Column="1" 
                                      Content="Remember Me"
                                      Style="{StaticResource ModernCheckBoxStyle}"
                                      IsChecked="{Binding RememberMe}"
                                      HorizontalAlignment="Right"/>
                        </Grid>

                        <!-- Status Message -->
                        <Border Name="StatusMessageBorder"
                                Background="{StaticResource ErrorColor}"
                                CornerRadius="8"
                                Padding="15,12"
                                Margin="0,0,0,20"
                                Visibility="Collapsed">
                            <TextBlock Name="StatusMessageBlock"
                                       Text="{Binding StatusMessage}"
                                       HorizontalAlignment="Center"
                                       Foreground="White"
                                       FontWeight="Medium"
                                       FontSize="14"/>
                        </Border>

                        <!-- Loading Indicator -->
                        <Border Name="LoadingBorder"
                                Background="{StaticResource SecondaryColor}"
                                CornerRadius="8"
                                Padding="15,12"
                                Margin="0,0,0,20"
                                Visibility="Collapsed">
                            <StackPanel Orientation="Horizontal" 
                                        HorizontalAlignment="Center">
                                <ProgressBar Name="LoadingProgressBar"
                                             IsIndeterminate="True"
                                             Height="4"
                                             Width="200"
                                             Foreground="White"
                                             Background="Transparent"
                                             BorderThickness="0"/>
                                <TextBlock Text="Authenticating..."
                                           Foreground="White"
                                           FontWeight="Medium"
                                           FontSize="14"
                                           Margin="15,0,0,0"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <!-- Buttons -->
                        <StackPanel Orientation="Horizontal" 
                                    HorizontalAlignment="Center"
                                    Margin="0,15,0,0">
                            <Button Content="Login"
                                    Style="{StaticResource LoginButtonStyle}"
                                    Command="{Binding LoginCommand}"
                                    IsDefault="True"
                                    MinWidth="140"
                                    Margin="0,0,20,0"/>
                            <Button Content="Exit"
                                    Style="{StaticResource ExitButtonStyle}"
                                    Command="{Binding ExitCommand}"
                                    MinWidth="140"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>