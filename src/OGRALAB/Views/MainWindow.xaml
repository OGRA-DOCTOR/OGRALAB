<Window x:Class="OGRALAB.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        xmlns:local="clr-namespace:OGRALAB"
        xmlns:converters="clr-namespace:OGRALAB.Converters" 
        Title="OGRALAB - نظام إدارة المختبرات الطبية"
        Height="700"
        Width="1200"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        FlowDirection="RightToLeft"
        Icon="../Images/ogralab_logo.png">

    <Window.Resources>
        <converters:NullToVisibilityConverter x:Key="NullToVisibilityConverter"/>
        <converters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>

        <!-- Colors and Styles as defined in your last correct version -->
        <SolidColorBrush x:Key="DashboardColor" Color="#FF4CAF50"/>
        <SolidColorBrush x:Key="AddPatientsColor" Color="#FF2196F3"/>
        <SolidColorBrush x:Key="EnterResultsColor" Color="#FFFFC107"/>
        <SolidColorBrush x:Key="PreviewReportsColor" Color="#FFE91E63"/>
        <SolidColorBrush x:Key="SearchModifyColor" Color="#FF9C27B0"/>
        <SolidColorBrush x:Key="SettingsColor" Color="#FF795548"/>
        <SolidColorBrush x:Key="LogoutColor" Color="#FFF44336"/>

        <Style x:Key="SideMenuButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Margin" Value="0,6"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" 
                                Background="{TemplateBinding Background}"
                                CornerRadius="0,25,25,0"
                                Margin="0,1"
                                Height="50">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="60"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0"
                                           Text="{TemplateBinding Tag}" 
                                           FontSize="24" 
                                           FontFamily="Segoe MDL2 Assets" 
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Center"/>

                                <ContentPresenter Grid.Column="1"
                                                  HorizontalAlignment="Right" 
                                                  VerticalAlignment="Center"
                                                  Margin="0,0,20,0"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#FF3A8DFF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#FFAAAAAA"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DashboardMenuItemStyle" TargetType="Button" BasedOn="{StaticResource SideMenuButtonStyle}"/>
        <Style x:Key="AddPatientsMenuItemStyle" TargetType="Button" BasedOn="{StaticResource SideMenuButtonStyle}"/>
        <Style x:Key="EnterResultsMenuItemStyle" TargetType="Button" BasedOn="{StaticResource SideMenuButtonStyle}"/>
        <Style x:Key="PreviewReportsMenuItemStyle" TargetType="Button" BasedOn="{StaticResource SideMenuButtonStyle}"/>
        <Style x:Key="SearchModifyMenuItemStyle" TargetType="Button" BasedOn="{StaticResource SideMenuButtonStyle}"/>
        <Style x:Key="SettingsMenuItemStyle" TargetType="Button" BasedOn="{StaticResource SideMenuButtonStyle}"/>
        <Style x:Key="LogoutMenuItemStyle" TargetType="Button" BasedOn="{StaticResource SideMenuButtonStyle}"/>

        <Style x:Key="SelectedMenuItemStyle" TargetType="Button" BasedOn="{StaticResource SideMenuButtonStyle}">
            <Setter Property="Background" Value="#FF007ACC"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style x:Key="DisabledMenuItemStyle" TargetType="Button" BasedOn="{StaticResource SideMenuButtonStyle}">
            <Setter Property="IsEnabled" Value="False"/>
            <Setter Property="Opacity" Value="0.5"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Background="#FF007ACC" Padding="20,15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="../Images/ogralab_logo.png" Height="50" Width="50" Margin="0,0,10,0"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="OGRALAB" FontSize="28" FontWeight="Bold" Foreground="White"/>
                        <TextBlock Text="نظام إدارة المختبرات الطبية" FontSize="14" Foreground="White" Opacity="0.9"/>
                    </StackPanel>
                </StackPanel>
                <TextBlock Grid.Column="1" Text="{Binding WelcomeMessage}" FontSize="16" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="👤" FontSize="18" VerticalAlignment="Center" Margin="0,0,5,0"/>
                    <TextBlock Text="{Binding CurrentUser.FullName}" FontSize="14" Foreground="White" VerticalAlignment="Center" Margin="0,0,15,0"/>
                </StackPanel>
            </Grid>
        </Border>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="#FF1E1E1E" BorderBrush="#FF444444" BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Background="#FF2D2D30" Padding="15,10">
                        <TextBlock Text="القائمة الرئيسية" FontSize="18" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>
                    </Border>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="10,5">
                        <StackPanel>
                            <Button Content="لوحة المعلومات" Style="{StaticResource DashboardMenuItemStyle}" Command="{Binding DashboardCommand}" Tag="📊"/>
                            <Button Content="إدخال المرضى" Style="{StaticResource AddPatientsMenuItemStyle}" Command="{Binding AddPatientsCommand}" Tag="👥"/>
                            <Button Content="إدخال النتائج" Style="{StaticResource EnterResultsMenuItemStyle}" Command="{Binding EnterResultsCommand}" Tag="🧪"/>
                            <Button Content="معاينة وطباعة التقارير" Style="{StaticResource PreviewReportsMenuItemStyle}" Command="{Binding PreviewReportsCommand}" Tag="📄"/>
                            <Button Content="البحث والتعديل" Style="{StaticResource SearchModifyMenuItemStyle}" Command="{Binding SearchModifyCommand}" Tag="🔍"/>
                            <Button Content="الإعدادات" Style="{StaticResource SettingsMenuItemStyle}" Command="{Binding SettingsCommand}" Tag="⚙️"/>
                            <Border Height="1" Background="#FF444444" Margin="10,15"/>
                            <Button Content="تسجيل الخروج" Style="{StaticResource LogoutMenuItemStyle}" Command="{Binding LogoutCommand}" Tag="🚪"/>
                        </StackPanel>
                    </ScrollViewer>
                    <Border Grid.Row="2" Background="#FF007ACC" Padding="10,8">
                        <StackPanel>
                            <TextBlock Text="نظام OGRALAB" FontSize="11" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>
                            <TextBlock Text="الإصدار 1.0.0" FontSize="9" Foreground="White" HorizontalAlignment="Center" Opacity="0.7"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
            <Border Grid.Column="1" Padding="20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,20" Grid.Row="0"
                                Visibility="{Binding ShowDashboardStats, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Border Background="#FF4CAF50" CornerRadius="10" Padding="20" Width="200" Height="100" Margin="8,0">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="إجمالي المرضى" FontSize="16" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>
                                <TextBlock Text="1234" FontSize="28" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Background="#FF2196F3" CornerRadius="10" Padding="20" Width="200" Height="100" Margin="8,0">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="مرضى مسجلين اليوم" FontSize="16" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>
                                <TextBlock Text="56" FontSize="28" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Background="#FFFFC107" CornerRadius="10" Padding="20" Width="200" Height="100" Margin="8,0">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="نتائج معالجات اليوم" FontSize="16" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>
                                <TextBlock Text="78" FontSize="28" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <ContentPresenter Content="{Binding CurrentContent}" Grid.Row="1"/>

                    <!-- *** تم حذف الـ StackPanel الخاص بالرسالة الترحيبية من هنا *** -->

                </Grid>
            </Border>
        </Grid>
        <Border Grid.Row="2" Background="#FF1E1E1E" Padding="15,5">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="جاهز للاستخدام" Foreground="White" VerticalAlignment="Center" FontSize="11"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,0,15,0">
                    <TextBlock Text="🟢" FontSize="10" VerticalAlignment="Center" Margin="0,0,3,0"/>
                    <TextBlock Text="متصل" Foreground="White" FontSize="10" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock Grid.Column="2" Text="{Binding Source={x:Static sys:DateTime.Now}, StringFormat='yyyy/MM/dd - HH:mm'}" Foreground="White" FontSize="10" VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</Window>