<Window x:Class="OGRALAB.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        Title="OGRALAB - نظام إدارة المختبرات الطبية"
        Height="700"
        Width="1200"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        FlowDirection="RightToLeft"
        Icon="../Images/ogralab_logo.png">
    
    <Window.Resources>
        <!-- أنماط القائمة الجانبية -->
        <Style x:Key="SideMenuButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="15,12"/>
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="HorizontalContentAlignment" Value="Right"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="{StaticResource WhiteColor}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" 
                                Background="{TemplateBinding Background}"
                                CornerRadius="0,25,25,0"
                                Margin="0,1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="50"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                
                                <ContentPresenter Grid.Column="0" 
                                                Grid.ColumnSpan="2"
                                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource HoverColor}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{StaticResource DisabledColor}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- نمط العنصر المحدد في القائمة -->
        <Style x:Key="SelectedMenuItemStyle" TargetType="Button" BasedOn="{StaticResource SideMenuButtonStyle}">
            <Setter Property="Background" Value="{StaticResource ActiveColor}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <!-- نمط العنصر المعطل في القائمة -->
        <Style x:Key="DisabledMenuItemStyle" TargetType="Button" BasedOn="{StaticResource SideMenuButtonStyle}">
            <Setter Property="IsEnabled" Value="False"/>
            <Setter Property="Opacity" Value="0.5"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- الرأس العلوي -->
        <Border Grid.Row="0" 
                Background="{StaticResource PrimaryColor}"
                Padding="20,15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- الشعار والعنوان -->
                <StackPanel Grid.Column="0" 
                           Orientation="Horizontal"
                           VerticalAlignment="Center">
                    <Image Source="../Images/ogralab_logo.png"
                           Height="40"
                           Width="40"
                           Margin="0,0,15,0"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="OGRALAB"
                                   FontSize="24"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource WhiteColor}"/>
                        <TextBlock Text="نظام إدارة المختبرات الطبية"
                                   FontSize="12"
                                   Foreground="{StaticResource WhiteColor}"
                                   Opacity="0.8"/>
                    </StackPanel>
                </StackPanel>

                <!-- رسالة الترحيب -->
                <TextBlock Grid.Column="1"
                           Text="{Binding WelcomeMessage}"
                           FontSize="16"
                           Foreground="{StaticResource WhiteColor}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>

                <!-- معلومات المستخدم -->
                <StackPanel Grid.Column="2" 
                           Orientation="Horizontal"
                           VerticalAlignment="Center">
                    <TextBlock Text="👤" 
                              FontSize="16"
                              VerticalAlignment="Center"
                              Margin="0,0,10,0"/>
                    <TextBlock Text="{Binding CurrentUser.FullName}"
                               FontSize="14"
                               Foreground="{StaticResource WhiteColor}"
                               VerticalAlignment="Center"
                               Margin="0,0,15,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- منطقة المحتوى الرئيسية -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- القائمة الجانبية -->
            <Border Grid.Column="0"
                    Background="{StaticResource ComplementaryColor}"
                    BorderBrush="{StaticResource BorderColor}"
                    BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- عنوان القائمة -->
                    <Border Grid.Row="0" 
                           Background="{StaticResource SecondaryColor}"
                           Padding="20,15">
                        <TextBlock Text="القائمة الرئيسية"
                                  FontSize="16"
                                  FontWeight="Bold"
                                  Foreground="{StaticResource WhiteColor}"
                                  HorizontalAlignment="Center"/>
                    </Border>

                    <!-- عناصر القائمة -->
                    <ScrollViewer Grid.Row="1" 
                                 VerticalScrollBarVisibility="Auto"
                                 Padding="10,15">
                        <StackPanel>
                            <!-- لوحة المعلومات -->
                            <Button Content="📊  لوحة المعلومات"
                                   Style="{StaticResource SelectedMenuItemStyle}"
                                   Command="{Binding DashboardCommand}"/>

                            <!-- إدخال المرضى -->
                            <Button Content="👥  إدخال المرضى"
                                   Style="{StaticResource DisabledMenuItemStyle}"
                                   Command="{Binding AddPatientsCommand}"/>

                            <!-- إدخال النتائج -->
                            <Button Content="📝  إدخال النتائج"
                                   Style="{StaticResource DisabledMenuItemStyle}"
                                   Command="{Binding EnterResultsCommand}"/>

                            <!-- معاينة وطباعة التقارير -->
                            <Button Content="📄  معاينة وطباعة التقارير"
                                   Style="{StaticResource DisabledMenuItemStyle}"
                                   Command="{Binding PreviewReportsCommand}"/>

                            <!-- البحث والتعديل -->
                            <Button Content="🔍  البحث والتعديل"
                                   Style="{StaticResource DisabledMenuItemStyle}"
                                   Command="{Binding SearchModifyCommand}"/>

                            <!-- الإعدادات -->
                            <Button Content="⚙️  الإعدادات"
                                   Style="{StaticResource DisabledMenuItemStyle}"
                                   Command="{Binding SettingsCommand}"/>

                            <!-- خط فاصل -->
                            <Border Height="1" 
                                   Background="{StaticResource BorderColor}"
                                   Margin="10,20"/>

                            <!-- تسجيل الخروج -->
                            <Button Content="🚪  تسجيل الخروج"
                                   Style="{StaticResource SideMenuButtonStyle}"
                                   Command="{Binding LogoutCommand}"/>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- معلومات النظام -->
                    <Border Grid.Row="2"
                           Background="{StaticResource PrimaryColor}"
                           Padding="15,10">
                        <StackPanel>
                            <TextBlock Text="نظام OGRALAB"
                                      FontSize="12"
                                      FontWeight="Bold"
                                      Foreground="{StaticResource WhiteColor}"
                                      HorizontalAlignment="Center"/>
                            <TextBlock Text="الإصدار 2.0.0"
                                      FontSize="10"
                                      Foreground="{StaticResource WhiteColor}"
                                      HorizontalAlignment="Center"
                                      Opacity="0.7"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- منطقة المحتوى -->
            <Grid Grid.Column="1">
                <ContentPresenter Content="{Binding CurrentContent}"/>
                
                <!-- محتوى احتياطي في حالة عدم وجود محتوى -->
                <StackPanel HorizontalAlignment="Center"
                           VerticalAlignment="Center">
                    <TextBlock Text="🏥"
                              FontSize="72"
                              HorizontalAlignment="Center"
                              Opacity="0.3"
                              Margin="0,0,0,20"/>
                    <TextBlock Text="مرحباً بك في نظام OGRALAB"
                               FontSize="32"
                               FontWeight="Bold"
                               Foreground="{StaticResource PrimaryColor}"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,10"/>
                    <TextBlock Text="نظام إدارة المختبرات الطبية المتطور"
                               FontSize="18"
                               Foreground="{StaticResource ComplementaryColor}"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,20"/>
                    <TextBlock Text="اختر من القائمة الجانبية للبدء"
                               FontSize="14"
                               Foreground="{StaticResource ComplementaryColor}"
                               HorizontalAlignment="Center"
                               FontStyle="Italic"/>
                </StackPanel>
            </Grid>
        </Grid>

        <!-- شريط الحالة -->
        <Border Grid.Row="2" 
                Background="{StaticResource ComplementaryColor}"
                Padding="20,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="جاهز للاستخدام"
                           Foreground="{StaticResource WhiteColor}"
                           VerticalAlignment="Center"/>

                <StackPanel Grid.Column="1" 
                           Orientation="Horizontal"
                           Margin="0,0,20,0">
                    <TextBlock Text="🟢" 
                              FontSize="12"
                              VerticalAlignment="Center"
                              Margin="0,0,5,0"/>
                    <TextBlock Text="متصل"
                               Foreground="{StaticResource WhiteColor}"
                               FontSize="12"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <TextBlock Grid.Column="2"
                           Text="{Binding Source={x:Static sys:DateTime.Now}, StringFormat='yyyy/MM/dd - HH:mm'}"
                           Foreground="{StaticResource WhiteColor}"
                           FontSize="12"
                           VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</Window>
