<Window x:Class="OGRALAB.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        xmlns:converters="clr-namespace:OGRALAB.Converters" 
        Title="OGRALAB - نظام إدارة المختبرات الطبية"
        Height="720" 
        Width="1280"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        FlowDirection="RightToLeft" 
        Icon="../Images/ogralab_logo.png"
        FontFamily="Segoe UI">

    <Window.Resources>
        <SolidColorBrush x:Key="SideMenuBackgroundColor" Color="#FF2D3748"/>
        <SolidColorBrush x:Key="SideMenuItemHoverColor" Color="#FF4A5568"/>
        <SolidColorBrush x:Key="SideMenuItemSelectedColor" Color="#FF007ACC"/>
        <SolidColorBrush x:Key="SideMenuItemForegroundColor" Color="#FFCBD5E0"/>
        <SolidColorBrush x:Key="SideMenuItemSelectedForegroundColor" Color="White"/>

        <SolidColorBrush x:Key="HeaderBackgroundColor" Color="#FF1A202C"/>
        <SolidColorBrush x:Key="StatusBarBackgroundColor" Color="#FF1A202C"/>
        <SolidColorBrush x:Key="ContentAreaBackgroundColor" Color="#FFF7FAFC"/>
        <SolidColorBrush x:Key="DisabledItemForegroundColor" Color="#FFAAAAAA"/>
        <SolidColorBrush x:Key="SeparatorLineColor" Color="#FFE2E8F0"/>
        <SolidColorBrush x:Key="LogoutButtonForegroundColor" Color="#FFEF5350"/>

        <SolidColorBrush x:Key="DashboardCardTotalPatients" Color="#FF4CAF50"/>
        <SolidColorBrush x:Key="DashboardCardRegisteredToday" Color="#FF2196F3"/>
        <SolidColorBrush x:Key="DashboardCardResultsProcessed" Color="#FFFFC107"/>

        <SolidColorBrush x:Key="DefaultContentTextColor" Color="#FF1E1E1E"/>
        <SolidColorBrush x:Key="DefaultContentAccentColor" Color="#FF007ACC"/>

        <!-- تأكد من أن مجلد Converters موجود وأن الملف NullToVisibilityConverter.cs بداخله بالـ namespace الصحيح -->
        <converters:NullToVisibilityConverter x:Key="NullToVisibilityConverter" />

        <Style x:Key="SideMenuButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource SideMenuItemForegroundColor}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="15,12"/>
            <Setter Property="Margin" Value="0,3"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="MinHeight" Value="45"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" 
                                Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Margin="10,0">
                            <ContentPresenter HorizontalAlignment="Right"
                                              VerticalAlignment="Center"
                                              Margin="10,0,0,0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource SideMenuItemHoverColor}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- الرأس العلوي -->
        <Border Grid.Row="0" Background="{StaticResource HeaderBackgroundColor}" Padding="20,15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="../Images/ogralab_logo.png" Height="40" Width="40" Margin="0,0,10,0" VerticalAlignment="Center"/>
                    <TextBlock Text="OGRALAB" FontSize="20" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                    <TextBlock Text="- نظام إدارة المختبرات الطبية" FontSize="14" Foreground="#B0BEC5" VerticalAlignment="Center" Margin="5,0,0,0"/>
                </StackPanel>
                <TextBlock Grid.Column="1" Text="{Binding WelcomeMessage, FallbackValue='مرحباً بك!'}" FontSize="16" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="👤" FontSize="18" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock Text="{Binding CurrentUser.FullName, FallbackValue='System Admin'}" FontSize="14" Foreground="White" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- منطقة المحتوى الرئيسية مع القائمة الجانبية -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250"/>
                <!-- القائمة الجانبية على اليسار (لأن FlowDirection العام للنافذة هو RightToLeft) -->
                <ColumnDefinition Width="*"/>
                <!-- منطقة المحتوى على اليمين -->
            </Grid.ColumnDefinitions>

            <!-- القائمة الجانبية -->
            <Border Grid.Column="0" Background="{StaticResource SideMenuBackgroundColor}" BorderBrush="#FF1A202C" BorderThickness="0,0,1,0">
                <!-- الخط الفاصل على يمين القائمة -->
                <StackPanel Margin="0,20,0,0">
                    <TextBlock Text="مرحباً بك في نظام OGRALAB" 
                               Foreground="{StaticResource SideMenuItemForegroundColor}" 
                               FontSize="14" 
                               FontWeight="SemiBold"
                               HorizontalAlignment="Right" 
                               Margin="25,0,25,20"
                               TextWrapping="Wrap"/>

                    <Button Content="لوحة المعلومات" Style="{StaticResource SideMenuButtonStyle}" Command="{Binding NavigateCommand}" CommandParameter="Dashboard"/>
                    <Button Content="إدخال المرضى" Style="{StaticResource SideMenuButtonStyle}" Command="{Binding NavigateCommand}" CommandParameter="AddPatients"/>
                    <Button Content="إدخال النتائج" Style="{StaticResource SideMenuButtonStyle}" Command="{Binding NavigateCommand}" CommandParameter="EnterResults" IsEnabled="False"/>
                    <Button Content="معاينة وطباعة التقارير" Style="{StaticResource SideMenuButtonStyle}" Command="{Binding NavigateCommand}" CommandParameter="PreviewReports" IsEnabled="False"/>
                    <Button Content="البحث والتعديل" Style="{StaticResource SideMenuButtonStyle}" Command="{Binding NavigateCommand}" CommandParameter="SearchModify" IsEnabled="False"/>
                    <Button Content="الإعدادات" Style="{StaticResource SideMenuButtonStyle}" Command="{Binding NavigateCommand}" CommandParameter="Settings" IsEnabled="False"/>

                    <Border Height="1" Background="{StaticResource SideMenuItemHoverColor}" Margin="10,15,10,15" Opacity="0.5"/>

                    <Button Content="تسجيل الخروج" Style="{StaticResource SideMenuButtonStyle}" Command="{Binding LogoutCommand}" Foreground="{StaticResource LogoutButtonForegroundColor}"/>
                </StackPanel>
            </Border>

            <!-- منطقة المحتوى الديناميكي -->
            <Border Grid.Column="1" Background="{StaticResource ContentAreaBackgroundColor}" Padding="25">
                <!-- المحتوى في العمود الثاني -->
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <!-- صف للإحصائيات -->
                        <RowDefinition Height="*"/>
                        <!-- صف للمحتوى الرئيسي -->
                    </Grid.RowDefinitions>

                    <!-- إحصائيات المرضى في الأعلى -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,20,0,20">
                        <Border Background="{StaticResource DashboardCardTotalPatients}" CornerRadius="10" Padding="20" Width="200" MinHeight="100" Margin="10">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="إجمالي المرضى" FontSize="16" FontWeight="SemiBold" Foreground="White" HorizontalAlignment="Center" TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding TotalPatients, FallbackValue='0'}" FontSize="28" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Background="{StaticResource DashboardCardRegisteredToday}" CornerRadius="10" Padding="20" Width="200" MinHeight="100" Margin="10">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="مرضى اليوم" FontSize="16" FontWeight="SemiBold" Foreground="White" HorizontalAlignment="Center" TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding PatientsToday, FallbackValue='0'}" FontSize="28" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Background="{StaticResource DashboardCardResultsProcessed}" CornerRadius="10" Padding="20" Width="200" MinHeight="100" Margin="10">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="نتائج جاهزة" FontSize="16" FontWeight="SemiBold" Foreground="White" HorizontalAlignment="Center" TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding ResultsReady, FallbackValue='0'}" FontSize="28" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- المحتوى الديناميكي (UserControl) -->
                    <ContentControl Grid.Row="1" Content="{Binding CurrentViewModel}" 
                                    HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                    Margin="0"/>
                    <!-- تم إزالة الهامش العلوي لأنه أصبح في صف منفصل -->

                    <!-- محتوى احتياطي إذا كان CurrentViewModel فارغاً -->
                    <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                                Visibility="{Binding CurrentViewModel, Converter={StaticResource NullToVisibilityConverter}, FallbackValue=Visible}">
                        <TextBlock Text="🏥" FontSize="60" HorizontalAlignment="Center" Opacity="0.3" Margin="0,0,0,15"/>
                        <TextBlock Text="مرحباً بك في نظام OGRALAB" FontSize="28" FontWeight="Bold" Foreground="{StaticResource DefaultContentAccentColor}" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                        <TextBlock Text="نظام إدارة المختبرات الطبية" FontSize="16" Foreground="{StaticResource DefaultContentTextColor}" HorizontalAlignment="Center" Margin="0,0,0,15" Opacity="0.8"/>
                        <TextBlock Text="اختر وظيفة من القائمة الجانبية للبدء." FontSize="14" Foreground="{StaticResource DefaultContentTextColor}" HorizontalAlignment="Center" FontStyle="Italic" Opacity="0.7"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- شريط الحالة -->
        <Border Grid.Row="2" Background="{StaticResource StatusBarBackgroundColor}" Padding="15,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="جاهز" Foreground="#B0BEC5" VerticalAlignment="Center" FontSize="12"/>
                <TextBlock Grid.Column="1" Text="{Binding AppVersion, FallbackValue='الإصدار 2.0.0'}" Foreground="#B0BEC5" FontSize="12" VerticalAlignment="Center" Margin="0,0,20,0"/>
                <TextBlock Grid.Column="2" Text="{Binding Source={x:Static sys:DateTime.Now}, StringFormat='dd/MM/yyyy HH:mm:ss'}" 
                           Foreground="#B0BEC5" FontSize="12" VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</Window>