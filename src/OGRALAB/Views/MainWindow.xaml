<Window x:Class="OGRALAB.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        xmlns:local="clr-namespace:OGRALAB"
        xmlns:viewModels="clr-namespace:OGRALAB.ViewModels"
        xmlns:converters="clr-namespace:OGRALAB.Converters" 
        mc:Ignorable="d"
        Title="OGRALAB - نظام إدارة المختبرات الطبية"
        Height="750" Width="1250"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        FlowDirection="RightToLeft"
        Icon="../Images/ogralab_logo.png"
        Background="#F0F2F5">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>

        <!-- *** ستايل زر القائمة الموحد *** -->
        <!-- تم دمج الستايل العادي والمختار في ستايل واحد باستخدام DataTrigger -->
        <Style x:Key="SideMenuItemStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Height" Value="50"/>
            <Setter Property="Margin" Value="10,3"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" 
                                Background="{TemplateBinding Background}"
                                CornerRadius="5">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <!-- الأيقونة -->
                                <TextBlock Grid.Column="0" 
                                           Text="{Binding Icon}" 
                                           FontFamily="Segoe MDL2 Assets" 
                                           FontSize="18"
                                           VerticalAlignment="Center" 
                                           Margin="15,0"/>
                                <!-- النص -->
                                <ContentPresenter Grid.Column="1" 
                                                  VerticalAlignment="Center" 
                                                  HorizontalAlignment="Right"
                                                  Margin="0,0,15,0"/>
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <!-- عند مرور الماوس فوق الزر -->
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FF3A8DFF"/>
                </Trigger>
                <!-- عندما يكون الزر غير مفعل -->
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Foreground" Value="#FFAAAAAA"/>
                    <Setter Property="Opacity" Value="0.6"/>
                </Trigger>
                <!-- عندما يكون العنصر هو المختار حالياً -->
                <!-- هذا يتطلب وجود خاصية اسمها IsSelected من نوع bool في الـ ViewModel الخاص بكل عنصر قائمة -->
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter Property="Background" Value="#FF007ACC"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ======================= -->
        <!--    القائمة الجانبية     -->
        <!-- ======================= -->
        <Border Grid.Column="0" Background="#FF1E1E1E">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- رأس القائمة -->
                <StackPanel Grid.Row="0" Margin="0,20,0,30" HorizontalAlignment="Center">
                    <Image Source="../Images/ogralab_logo.png" Height="60" Width="60"/>
                    <TextBlock Text="OGRALAB" Foreground="White" FontSize="22" FontWeight="Bold" Margin="0,10,0,0" HorizontalAlignment="Center"/>
                    <TextBlock Text="نظام إدارة المختبرات" Foreground="#CCCCCC" FontSize="12" HorizontalAlignment="Center"/>
                </StackPanel>

                <!-- عناصر القائمة (مربوطة بالـ ViewModel) -->
                <!-- تم تصحيح طريقة تطبيق الستايل -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding MenuItems}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Content="{Binding Name}"
                                        Command="{Binding Command}"
                                        IsEnabled="{Binding IsEnabled}"
                                        Style="{StaticResource SideMenuItemStyle}"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- تذييل القائمة -->
                <StackPanel Grid.Row="2" Margin="0,15">
                    <TextBlock Text="الإصدار 1.0.0" FontSize="11" Foreground="#888888" HorizontalAlignment="Center"/>
                </StackPanel>

            </Grid>
        </Border>

        <!-- ======================= -->
        <!--    المحتوى الرئيسي      -->
        <!-- ======================= -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- الشريط العلوي -->
            <Border Grid.Row="0" Background="White" BorderBrush="#DDDDDD" BorderThickness="0,0,0,1" Padding="20,15">
                <Grid>
                    <TextBlock Text="{Binding WelcomeMessage}" 
                               FontSize="18" FontWeight="SemiBold" 
                               Foreground="#333333"
                               VerticalAlignment="Center"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <!-- يمكنك إضافة عناصر هنا مثل الساعة أو اسم المستخدم -->
                        <TextBlock Text="{Binding Source={x:Static sys:DateTime.Now}, StringFormat='dddd, dd MMMM yyyy'}" 
                                   Foreground="#555555" VerticalAlignment="Center" FontSize="14"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- منطقة عرض المحتوى -->
            <Border Grid.Row="1" Padding="25">
                <ContentPresenter Content="{Binding CurrentContent}"/>
            </Border>

            <!-- شريط الحالة السفلي -->
            <Border Grid.Row="2" Background="#FF1E1E1E" Padding="15,8">
                <Grid>
                    <TextBlock Text="الحالة: جاهز" Foreground="White" VerticalAlignment="Center" FontSize="12"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>