<UserControl x:Class="OGRALAB.Views.AddPatientUserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:enums="clr-namespace:OGRALAB.Enums"
             xmlns:converters="clr-namespace:OGRALAB.Converters"
             mc:Ignorable="d"
             d:DesignHeight="840" d:DesignWidth="1160"
             FlowDirection="RightToLeft"
             FontFamily="Segoe UI"
             FontSize="14"
             Background="{DynamicResource WindowBackground}">
    <!-- Changed to DynamicResource if defined in App.xaml -->

    <UserControl.Resources>
        <converters:EnumToBooleanConverter x:Key="EnumToBooleanConverter"/>
        <converters:StringToVisibilityConverter x:Key="StringToVisibilityConverter"/>
        <converters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <!-- NullToVisibilityConverter and EnumValuesProvider are used directly, no need for x:Key if not referenced elsewhere as StaticResource -->
    </UserControl.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" Padding="5">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                    <GroupBox Header="بيانات المريض الأساسية" Style="{DynamicResource ModernGroupBoxStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Label Grid.Row="0" Grid.Column="0" Content="كود المريض:" Style="{DynamicResource ModernLabelStyle}"/>
                            <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding PatientCode}" IsReadOnly="True" Background="#F5F5F5" FontWeight="Bold" Style="{DynamicResource ModernTextBoxStyle}"/>
                            <Label Grid.Row="1" Grid.Column="0" Content="اللقب:" Style="{DynamicResource ModernLabelStyle}"/>
                            <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding AvailableTitles}" SelectedItem="{Binding SelectedTitle}" Style="{DynamicResource ModernComboBoxStyle}"/>
                            <Label Grid.Row="2" Grid.Column="0" Content="الاسم الكامل:*" Style="{DynamicResource ModernLabelStyle}"/>
                            <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding FullName}" Style="{DynamicResource ModernTextBoxStyle}"/>
                            <Label Grid.Row="3" Grid.Column="0" Content="الجنس:" Style="{DynamicResource ModernLabelStyle}"/>
                            <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <RadioButton Content="ذكر" GroupName="Gender" Margin="0,0,20,0" Style="{DynamicResource ModernRadioButtonStyle}" IsChecked="{Binding SelectedGender, ConverterParameter={x:Static enums:Gender.Male}, Converter={StaticResource EnumToBooleanConverter}}"/>
                                <RadioButton Content="أنثى" GroupName="Gender" Margin="0,0,20,0" Style="{DynamicResource ModernRadioButtonStyle}" IsChecked="{Binding SelectedGender, ConverterParameter={x:Static enums:Gender.Female}, Converter={StaticResource EnumToBooleanConverter}}"/>
                                <RadioButton Content="غير معروف" GroupName="Gender" Style="{DynamicResource ModernRadioButtonStyle}" IsChecked="{Binding SelectedGender, ConverterParameter={x:Static enums:Gender.Unknown}, Converter={StaticResource EnumToBooleanConverter}}"/>
                            </StackPanel>
                            <Label Grid.Row="4" Grid.Column="0" Content="العمر:" Style="{DynamicResource ModernLabelStyle}"/>
                            <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal">
                                <TextBox Width="80" Text="{Binding Age}" Margin="0,0,10,0" Style="{DynamicResource ModernTextBoxStyle}"/>
                                <ComboBox Width="100" SelectedItem="{Binding SelectedAgeUnit}" Style="{DynamicResource ModernComboBoxStyle}" ItemsSource="{Binding Source={converters:EnumValuesProvider {x:Type enums:AgeUnit}}}"/>
                            </StackPanel>
                            <Label Grid.Row="5" Grid.Column="0" Content="رقم الموبايل:" Style="{DynamicResource ModernLabelStyle}"/>
                            <TextBox Grid.Row="5" Grid.Column="1" Text="{Binding MobileNumber}" MaxLength="11" Style="{DynamicResource ModernTextBoxStyle}"/>
                        </Grid>
                    </GroupBox>
                    <GroupBox Header="بيانات الطبيب والجهة" Style="{DynamicResource ModernGroupBoxStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <CheckBox Grid.Row="0" Grid.ColumnSpan="2" Content="طباعة الفاتورة" IsChecked="{Binding PrintInvoice}" Margin="0,0,0,10" Style="{DynamicResource ModernCheckBoxStyle}"/>
                            <Label Grid.Row="1" Grid.Column="0" Content="الطبيب:" Style="{DynamicResource ModernLabelStyle}"/>
                            <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding Doctors}" SelectedItem="{Binding SelectedDoctor}" DisplayMemberPath="FullName" IsEditable="True" IsTextSearchEnabled="True" Style="{DynamicResource ModernComboBoxStyle}"/>
                            <Label Grid.Row="2" Grid.Column="0" Content="الجهة/العيادة:" Style="{DynamicResource ModernLabelStyle}"/>
                            <ComboBox Grid.Row="2" Grid.Column="1" ItemsSource="{Binding Entities}" SelectedItem="{Binding SelectedEntity}" DisplayMemberPath="Name" IsEditable="True" IsTextSearchEnabled="True" Style="{DynamicResource ModernComboBoxStyle}"/>
                        </Grid>
                    </GroupBox>
                    <GroupBox Header="حساب التكلفة" Style="{DynamicResource ModernGroupBoxStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Label Grid.Row="0" Grid.Column="0" Content="إجمالي المبلغ:" Style="{DynamicResource ModernLabelStyle}"/>
                            <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding TotalAmount, StringFormat=N2}" IsReadOnly="True" Background="#F5F5F5" Style="{DynamicResource ModernTextBoxStyle}"/>
                            <Label Grid.Row="0" Grid.Column="2" Content="ريال" Style="{DynamicResource ModernLabelStyle}"/>
                            <Label Grid.Row="1" Grid.Column="0" Content="نسبة الخصم:" Style="{DynamicResource ModernLabelStyle}"/>
                            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding DiscountPercentage}" Style="{DynamicResource ModernTextBoxStyle}"/>
                            <Label Grid.Row="1" Grid.Column="2" Content="%" Style="{DynamicResource ModernLabelStyle}"/>
                            <Label Grid.Row="2" Grid.Column="0" Content="قيمة الخصم:" Style="{DynamicResource ModernLabelStyle}"/>
                            <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding DiscountAmount, StringFormat=N2}" IsReadOnly="True" Background="#F5F5F5" Style="{DynamicResource ModernTextBoxStyle}"/>
                            <Label Grid.Row="2" Grid.Column="2" Content="ريال" Style="{DynamicResource ModernLabelStyle}"/>
                            <Label Grid.Row="3" Grid.Column="0" Content="المبلغ بعد الخصم:" Style="{DynamicResource ModernLabelStyle}"/>
                            <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding AmountAfterDiscount, StringFormat=N2}" IsReadOnly="True" Background="#F5F5F5" FontWeight="Bold" Style="{DynamicResource ModernTextBoxStyle}"/>
                            <Label Grid.Row="3" Grid.Column="2" Content="ريال" Style="{DynamicResource ModernLabelStyle}"/>
                            <Label Grid.Row="4" Grid.Column="0" Content="المدفوع مسبقاً:" Style="{DynamicResource ModernLabelStyle}"/>
                            <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding PaidAmount}" Style="{DynamicResource ModernTextBoxStyle}"/>
                            <Label Grid.Row="4" Grid.Column="2" Content="ريال" Style="{DynamicResource ModernLabelStyle}"/>
                            <Label Grid.Row="5" Grid.Column="0" Content="المتبقي للتحصيل:" Style="{DynamicResource ModernLabelStyle}"/>
                            <TextBox Grid.Row="5" Grid.Column="1" Text="{Binding RemainingAmount, StringFormat=N2}" IsReadOnly="True" Background="#FFE6E6" FontWeight="Bold" Style="{DynamicResource ModernTextBoxStyle}"/>
                            <Label Grid.Row="5" Grid.Column="2" Content="ريال" Style="{DynamicResource ModernLabelStyle}"/>
                        </Grid>
                    </GroupBox>
                </StackPanel>

                <GroupBox Grid.Column="1" Header="اختيار الفحوصات" Margin="10,0,0,0" Style="{DynamicResource ModernGroupBoxStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="200"/>
                        </Grid.RowDefinitions>
                        <TextBox Grid.Row="0" Text="{Binding TestSearchText, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10" Style="{DynamicResource ModernTextBoxWithPlaceholderStyle}" Tag="البحث في الفحوصات..."/>
                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ListBox Grid.Column="0" ItemsSource="{Binding FilteredAvailableTests}" SelectedItem="{Binding SelectedAvailableTest}" Margin="0,0,5,0" Style="{DynamicResource ModernListBoxStyle}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Vertical" Margin="5">
                                            <TextBlock Text="{Binding TestName}" FontWeight="Bold"/>
                                            <TextBlock Text="{Binding Category}" FontSize="12" Foreground="Gray"/>
                                            <TextBlock Text="{Binding Price, StringFormat='{}{0:N2} ريال'}" FontSize="12" Foreground="Blue"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="5,0,0,0">
                                <Button Content="إضافة" Command="{Binding AddTestCommand}" Style="{DynamicResource PrimaryButton}" Margin="0,0,0,5"/>
                                <Button Content="حذف" Command="{Binding RemoveTestCommand}" Style="{DynamicResource SecondaryButton}" Margin="0,0,0,5"/>
                                <Button Content="حذف الكل" Command="{Binding RemoveAllTestsCommand}" Style="{DynamicResource SecondaryButton}"/>
                            </StackPanel>
                        </Grid>
                        <Separator Grid.Row="2" Margin="0,10"/>
                        <Grid Grid.Row="3">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Label Grid.Row="0" Content="الفحوصات المختارة:" FontWeight="Bold" Style="{DynamicResource ModernLabelStyle}"/>
                            <ListBox Grid.Row="1" ItemsSource="{Binding SelectedTests}" SelectedItem="{Binding SelectedTestForRemoval}" Background="#F9F9F9" Style="{DynamicResource ModernListBoxStyle}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="5">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Orientation="Vertical">
                                                <TextBlock Text="{Binding TestName}" FontWeight="Bold"/>
                                                <TextBlock Text="{Binding Abbreviation}" FontSize="12" Foreground="Gray"/>
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Text="{Binding Price, StringFormat='{}{0:N2} ريال'}" FontWeight="Bold" Foreground="Blue" VerticalAlignment="Center"/>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Grid>
                </GroupBox>
            </Grid>
        </ScrollViewer>

        <Border Grid.Row="1" Background="#F5F5F5" Padding="10" BorderThickness="0,1,0,0" BorderBrush="{StaticResource BorderColor}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding ErrorMessage}" Foreground="Red" FontWeight="SemiBold" Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibilityConverter}}"/>
                    <TextBlock Text="{Binding SuccessMessage}" Foreground="Green" FontWeight="SemiBold" Visibility="{Binding SuccessMessage, Converter={StaticResource StringToVisibilityConverter}}"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="حفظ" Command="{Binding SavePatientCommand}" Style="{DynamicResource PrimaryButton}" Margin="5,0"/>
                    <Button Content="إلغاء" Command="{Binding CancelCommand}" Style="{DynamicResource SecondaryButton}" Margin="5,0"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="10,0,0,0" Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <ProgressBar IsIndeterminate="True" Width="100" Height="20" Margin="0,0,10,0"/>
                    <TextBlock Text="جاري المعالجة..." VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>