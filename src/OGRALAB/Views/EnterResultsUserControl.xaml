<UserControl x:Class="OGRALAB.Views.EnterResultsUserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:enums="clr-namespace:OGRALAB.Enums"
             xmlns:converters="clr-namespace:OGRALAB.Converters"
             mc:Ignorable="d"
             d:DesignHeight="840" d:DesignWidth="1360"
             FlowDirection="RightToLeft"
             FontFamily="Segoe UI"
             FontSize="14"
             Background="{DynamicResource WindowBackground}">

    <UserControl.Resources>
        <converters:NullToVisibilityConverter x:Key="NullToVisibilityConverter"/>
        <converters:StringToVisibilityConverter x:Key="StringToVisibilityConverter"/>
        <converters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <converters:EnumToBooleanConverter x:Key="EnumToBooleanConverter"/>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- شريط البحث -->
        <GroupBox Grid.Row="0" Grid.ColumnSpan="2" Header="البحث عن المرضى" Style="{DynamicResource ModernGroupBoxStyle}" Padding="10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Row="0" Grid.Column="0" Margin="5">
                    <Label Content="كود المريض:" Style="{DynamicResource ModernLabelStyle}"/>
                    <TextBox Text="{Binding PatientCodeSearch, UpdateSourceTrigger=PropertyChanged}" Style="{DynamicResource ModernTextBoxStyle}"/>
                </StackPanel>
                <StackPanel Grid.Row="0" Grid.Column="1" Margin="5">
                    <Label Content="اسم المريض:" Style="{DynamicResource ModernLabelStyle}"/>
                    <TextBox Text="{Binding PatientNameSearch}" Style="{DynamicResource ModernTextBoxStyle}"/>
                </StackPanel>
                <StackPanel Grid.Row="0" Grid.Column="2" Margin="5">
                    <Label Content="الجنس:" Style="{DynamicResource ModernLabelStyle}"/>
                    <!-- *** تم تعديل السطر التالي: إزالة AddNullItem=True *** -->
                    <ComboBox SelectedItem="{Binding GenderFilter}" Style="{DynamicResource ModernComboBoxStyle}"
                              ItemsSource="{Binding Source={converters:EnumValuesProvider {x:Type enums:Gender}}}"/>
                </StackPanel>
                <StackPanel Grid.Row="0" Grid.Column="3" Margin="5">
                    <Label Content="الطبيب:" Style="{DynamicResource ModernLabelStyle}"/>
                    <TextBox Text="{Binding DoctorFilter}" Style="{DynamicResource ModernTextBoxStyle}"/>
                </StackPanel>
                <StackPanel Grid.Row="0" Grid.Column="4" Margin="5">
                    <Label Content="العمر من:" Style="{DynamicResource ModernLabelStyle}"/>
                    <TextBox Text="{Binding AgeFromFilter}" Style="{DynamicResource ModernTextBoxStyle}"/>
                </StackPanel>
                <StackPanel Grid.Row="0" Grid.Column="5" Margin="5">
                    <Label Content="العمر إلى:" Style="{DynamicResource ModernLabelStyle}"/>
                    <TextBox Text="{Binding AgeToFilter}" Style="{DynamicResource ModernTextBoxStyle}"/>
                </StackPanel>

                <StackPanel Grid.Row="1" Grid.ColumnSpan="6" Orientation="Horizontal" HorizontalAlignment="Left" Margin="5,10,5,5">
                    <Button Content="بحث" Command="{Binding SearchPatientsCommand}" Style="{DynamicResource PrimaryButton}" Margin="0,0,5,0"/>
                    <Button Content="مسح الفلاتر" Command="{Binding ClearFiltersCommand}" Style="{DynamicResource SecondaryButton}"/>
                </StackPanel>
            </Grid>
        </GroupBox>

        <!-- باقي الكود كما هو ... (لن أكرره بالكامل هنا للاختصار، فقط الجزء الذي تم تعديله وما يليه مباشرة للتأكد) -->
        <!-- قائمة المرضى الجانبية -->
        <Grid Grid.Row="1" Grid.Column="0" Margin="0,5,0,0">
            <!-- ... (نفس محتوى قائمة المرضى الجانبية) ... -->
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <GroupBox Grid.Row="0" Header="مرضى اليوم" Style="{DynamicResource ModernGroupBoxStyle}" Margin="5,0,5,0">
                <TextBlock Text="{Binding TodayPatients.Count, StringFormat='عدد المرضى: {0}'}" FontWeight="Bold"/>
            </GroupBox>
            <ListBox Grid.Row="1" ItemsSource="{Binding TodayPatients}" SelectedItem="{Binding SelectedPatient}" Margin="5,0,5,5" Style="{DynamicResource ModernListBoxStyle}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Padding="5" BorderBrush="LightGray" BorderThickness="0,0,0,1">
                            <StackPanel Orientation="Vertical">
                                <TextBlock Text="{Binding PatientCode}" FontWeight="Bold" FontSize="12"/>
                                <TextBlock Text="{Binding FullName}" FontSize="14"/>
                                <TextBlock Text="{Binding Doctor.FullName}" FontSize="11" Foreground="Gray"/>
                                <TextBlock Text="{Binding TestRequests.Count, StringFormat='عدد الفحوصات: {0}'}" FontSize="11" Foreground="Blue"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <GroupBox Grid.Row="2" Header="نتائج البحث" Style="{DynamicResource ModernGroupBoxStyle}" Margin="5,5,5,0">
                <TextBlock Text="{Binding SearchResults.Count, StringFormat='عدد النتائج: {0}'}" FontWeight="Bold"/>
            </GroupBox>
            <ListBox Grid.Row="3" ItemsSource="{Binding SearchResults}" SelectedItem="{Binding SelectedPatient}" Margin="5,0,5,5" Style="{DynamicResource ModernListBoxStyle}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Padding="5" BorderBrush="LightGray" BorderThickness="0,0,0,1">
                            <StackPanel Orientation="Vertical">
                                <TextBlock Text="{Binding PatientCode}" FontWeight="Bold" FontSize="12"/>
                                <TextBlock Text="{Binding FullName}" FontSize="14"/>
                                <TextBlock Text="{Binding Doctor.FullName}" FontSize="11" Foreground="Gray"/>
                                <TextBlock Text="{Binding CreatedDate, StringFormat='dd/MM/yyyy'}" FontSize="11" Foreground="Gray"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>

        <!-- منطقة النتائج الرئيسية (تبقى كما هي) -->
        <Grid Grid.Row="1" Grid.Column="1" Margin="5,5,5,0">
            <!-- ... (نفس محتوى منطقة النتائج الرئيسية) ... -->
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="150"/>
            </Grid.RowDefinitions>

            <GroupBox Grid.Row="0" Header="معلومات المريض" Style="{DynamicResource ModernGroupBoxStyle}" Visibility="{Binding SelectedPatient, Converter={StaticResource NullToVisibilityConverter}}">
                <Grid Margin="5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="كود المريض:" FontWeight="Bold"/>
                        <TextBlock Text="{Binding SelectedPatient.PatientCode}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="الاسم:" FontWeight="Bold"/>
                        <TextBlock Text="{Binding SelectedPatient.FullName}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="العمر:" FontWeight="Bold"/>
                        <TextBlock Text="{Binding SelectedPatient.Age}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="3">
                        <TextBlock Text="الطبيب:" FontWeight="Bold"/>
                        <TextBlock Text="{Binding SelectedPatient.Doctor.FullName}"/>
                    </StackPanel>
                </Grid>
            </GroupBox>

            <GroupBox Grid.Row="1" Header="نتائج الفحوصات" Style="{DynamicResource ModernGroupBoxStyle}" Margin="0,5,0,0" Visibility="{Binding SelectedPatient, Converter={StaticResource NullToVisibilityConverter}}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Background="#F0F0F0" Padding="5" BorderBrush="LightGray" BorderThickness="0,0,0,1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="1.5*"/>
                                <ColumnDefinition Width="60"/>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="1.5*"/>
                                <ColumnDefinition Width="60"/>
                                <ColumnDefinition Width="60"/>
                                <ColumnDefinition Width="60"/>
                                <ColumnDefinition Width="60"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="الاختصار" FontWeight="Bold" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="النتيجة" FontWeight="Bold" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="2" Text="الوحدة" FontWeight="Bold" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="3" Text="H-L" FontWeight="Bold" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="4" Text="الطبيعي" FontWeight="Bold" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="5" Text="انتهاء" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                            <TextBlock Grid.Column="6" Text="مراجعة" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                            <TextBlock Grid.Column="7" Text="طباعة" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                            <TextBlock Grid.Column="8" Text="تصدير" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Grid>
                    </Border>
                    <ListBox Grid.Row="1" ItemsSource="{Binding TestResults}" SelectedItem="{Binding SelectedTestResult}" ScrollViewer.HorizontalScrollBarVisibility="Auto" Style="{DynamicResource ModernListBoxStyle}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{Binding BackgroundColor}" BorderBrush="#DDDDDD" BorderThickness="0,0,0,1" Padding="0,2">
                                    <Grid Height="30">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="80"/>
                                            <ColumnDefinition Width="1.5*"/>
                                            <ColumnDefinition Width="60"/>
                                            <ColumnDefinition Width="80"/>
                                            <ColumnDefinition Width="1.5*"/>
                                            <ColumnDefinition Width="60"/>
                                            <ColumnDefinition Width="60"/>
                                            <ColumnDefinition Width="60"/>
                                            <ColumnDefinition Width="60"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding TestAbbreviation}" VerticalAlignment="Center" Margin="5,0"/>
                                        <TextBox Grid.Column="1" Text="{Binding TextResultValue}" VerticalAlignment="Center" Margin="2" Style="{DynamicResource ModernTextBoxStyle}" Height="25"/>
                                        <TextBlock Grid.Column="2" Text="{Binding TestUnit}" VerticalAlignment="Center" Margin="5,0"/>
                                        <TextBlock Grid.Column="3" Text="{Binding FlagText}" VerticalAlignment="Center" Margin="5,0" Foreground="{Binding ForegroundColor}" FontWeight="Bold"/>
                                        <TextBlock Grid.Column="4" Text="{Binding NormalRange}" VerticalAlignment="Center" Margin="5,0" FontSize="11"/>
                                        <CheckBox Grid.Column="5" IsChecked="{Binding IsCompleted}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                        <CheckBox Grid.Column="6" IsChecked="{Binding IsReviewed}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                        <CheckBox Grid.Column="7" IsChecked="{Binding IsPrinted}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                        <CheckBox Grid.Column="8" IsChecked="{Binding IsExported}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </GroupBox>

            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,10,0,5" Visibility="{Binding SelectedPatient, Converter={StaticResource NullToVisibilityConverter}}">
                <Button Content="حفظ النتائج" Command="{Binding SaveResultsCommand}" Style="{DynamicResource PrimaryButton}" Margin="0,0,5,0"/>
                <Button Content="مراجعة النتيجة" Command="{Binding ReviewResultCommand}" Style="{DynamicResource SecondaryButton}" Margin="0,0,5,0"/>
                <Button Content="طباعة" Command="{Binding PrintResultsCommand}" Style="{DynamicResource SecondaryButton}" Margin="0,0,5,0"/>
                <Button Content="تصدير" Command="{Binding ExportResultsCommand}" Style="{DynamicResource SecondaryButton}"/>
            </StackPanel>

            <GroupBox Grid.Row="3" Header="التعليقات" Style="{DynamicResource ModernGroupBoxStyle}" Visibility="{Binding SelectedPatient, Converter={StaticResource NullToVisibilityConverter}}">
                <Grid Margin="5">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,5,5">
                        <Label Content="التعليقات الجاهزة:" Style="{DynamicResource ModernLabelStyle}"/>
                        <ComboBox ItemsSource="{Binding PredefinedComments}" SelectedItem="{Binding SelectedPredefinedComment}" Style="{DynamicResource ModernComboBoxStyle}"/>
                    </StackPanel>
                    <StackPanel Grid.Row="0" Grid.Column="1" Margin="5,0,0,5">
                        <Label Content="تعليقات الفحص المختار:" Style="{DynamicResource ModernLabelStyle}"/>
                        <TextBox Text="{Binding SelectedTestResult.CommentsValue}" Height="30" Style="{DynamicResource ModernTextBoxStyle}"/>
                    </StackPanel>
                    <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Margin="0,5,0,0">
                        <Label Content="تعليقات عامة:" Style="{DynamicResource ModernLabelStyle}"/>
                        <TextBox Text="{Binding GeneralComments}" Height="50" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" TextWrapping="Wrap" Style="{DynamicResource ModernTextBoxStyle}"/>
                    </StackPanel>
                </Grid>
            </GroupBox>
        </Grid>

        <!-- شريط الحالة (يبقى كما هو) -->
        <Border Grid.Row="2" Grid.ColumnSpan="2" Background="#F5F5F5" Padding="10" BorderThickness="0,1,0,0" BorderBrush="{StaticResource BorderColor}">
            <!-- ... (نفس محتوى شريط الحالة) ... -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding ErrorMessage}" Foreground="Red" FontWeight="SemiBold" Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibilityConverter}}"/>
                    <TextBlock Text="{Binding SuccessMessage}" Foreground="Green" FontWeight="SemiBold" Visibility="{Binding SuccessMessage, Converter={StaticResource StringToVisibilityConverter}}"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <ProgressBar IsIndeterminate="True" Width="100" Height="20" Margin="0,0,10,0"/>
                    <TextBlock Text="جاري المعالجة..." VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>