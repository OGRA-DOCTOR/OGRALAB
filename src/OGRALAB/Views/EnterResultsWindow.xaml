<Window x:Class="OGRALAB.Views.EnterResultsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:enums="clr-namespace:OGRALAB.Enums"
        mc:Ignorable="d"
        Title="إدخال النتائج - OGRALAB"
        Height="900" Width="1400"
        WindowStartupLocation="CenterOwner"
        FlowDirection="RightToLeft"
        FontFamily="Segoe UI"
        FontSize="14">

    <Window.Resources>
        <Style TargetType="GroupBox">
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="BorderBrush" Value="#CCCCCC"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        
        <Style TargetType="Label">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontWeight" Value="Normal"/>
        </Style>
        
        <Style TargetType="TextBox">
            <Setter Property="Height" Value="30"/>
            <Setter Property="Padding" Value="5,2"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="BorderBrush" Value="#CCCCCC"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        
        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="30"/>
            <Setter Property="Padding" Value="5,2"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="BorderBrush" Value="#CCCCCC"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        
        <Style TargetType="Button">
            <Setter Property="Padding" Value="15,8"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#0078D4"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#0078D4"/>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#F3F2F1"/>
            <Setter Property="Foreground" Value="#323130"/>
            <Setter Property="BorderBrush" Value="#8A8886"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- شريط البحث -->
        <GroupBox Grid.Row="0" Grid.ColumnSpan="2" Header="البحث عن المرضى">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- الصف الأول -->
                <StackPanel Grid.Row="0" Grid.Column="0" Margin="5">
                    <Label Content="كود المريض:"/>
                    <TextBox Text="{Binding PatientCodeSearch, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>

                <StackPanel Grid.Row="0" Grid.Column="1" Margin="5">
                    <Label Content="اسم المريض:"/>
                    <TextBox Text="{Binding PatientNameSearch}"/>
                </StackPanel>

                <StackPanel Grid.Row="0" Grid.Column="2" Margin="5">
                    <Label Content="الجنس:"/>
                    <ComboBox SelectedIndex="0">
                        <ComboBoxItem Content="الكل"/>
                        <ComboBoxItem Content="ذكر"/>
                        <ComboBoxItem Content="أنثى"/>
                        <ComboBoxItem Content="غير محدد"/>
                    </ComboBox>
                </StackPanel>

                <StackPanel Grid.Row="0" Grid.Column="3" Margin="5">
                    <Label Content="الطبيب:"/>
                    <TextBox Text="{Binding DoctorFilter}"/>
                </StackPanel>

                <StackPanel Grid.Row="0" Grid.Column="4" Margin="5">
                    <Label Content="العمر من:"/>
                    <TextBox Text="{Binding AgeFromFilter}"/>
                </StackPanel>

                <StackPanel Grid.Row="0" Grid.Column="5" Margin="5">
                    <Label Content="العمر إلى:"/>
                    <TextBox Text="{Binding AgeToFilter}"/>
                </StackPanel>

                <!-- الصف الثاني - الأزرار -->
                <StackPanel Grid.Row="1" Grid.ColumnSpan="6" Orientation="Horizontal" HorizontalAlignment="Left" Margin="5">
                    <Button Content="بحث" Command="{Binding SearchPatientsCommand}" Style="{StaticResource PrimaryButton}"/>
                    <Button Content="مسح الفلاتر" Command="{Binding ClearFiltersCommand}" Style="{StaticResource SecondaryButton}"/>
                </StackPanel>
            </Grid>
        </GroupBox>

        <!-- قائمة المرضى الجانبية -->
        <Grid Grid.Row="1" Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- مرضى اليوم -->
            <GroupBox Grid.Row="0" Header="مرضى اليوم" Margin="5,0,0,0">
                <TextBlock Text="{Binding TodayPatients.Count, StringFormat='عدد المرضى: {0}'}" FontWeight="Bold"/>
            </GroupBox>

            <ListBox Grid.Row="1" ItemsSource="{Binding TodayPatients}" 
                     SelectedItem="{Binding SelectedPatient}" Margin="5,0,0,5">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Vertical" Margin="5">
                            <TextBlock Text="{Binding PatientCode}" FontWeight="Bold" FontSize="12"/>
                            <TextBlock Text="{Binding FullName}" FontSize="14"/>
                            <TextBlock Text="{Binding Doctor.FullName}" FontSize="11" Foreground="Gray"/>
                            <TextBlock Text="{Binding TestRequests.Count, StringFormat='عدد الفحوصات: {0}'}" 
                                       FontSize="11" Foreground="Blue"/>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- نتائج البحث -->
            <GroupBox Grid.Row="2" Header="نتائج البحث" Margin="5,0,0,0">
                <TextBlock Text="{Binding SearchResults.Count, StringFormat='عدد النتائج: {0}'}" FontWeight="Bold"/>
            </GroupBox>

            <ListBox Grid.Row="3" ItemsSource="{Binding SearchResults}" 
                     SelectedItem="{Binding SelectedPatient}" Margin="5,0,0,5">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Vertical" Margin="5">
                            <TextBlock Text="{Binding PatientCode}" FontWeight="Bold" FontSize="12"/>
                            <TextBlock Text="{Binding FullName}" FontSize="14"/>
                            <TextBlock Text="{Binding Doctor.FullName}" FontSize="11" Foreground="Gray"/>
                            <TextBlock Text="{Binding CreatedDate, StringFormat='dd/MM/yyyy'}" 
                                       FontSize="11" Foreground="Gray"/>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>

        <!-- منطقة النتائج الرئيسية -->
        <Grid Grid.Row="1" Grid.Column="1" Margin="10,0,10,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="150"/>
            </Grid.RowDefinitions>

            <!-- معلومات المريض المختار -->
            <GroupBox Grid.Row="0" Header="معلومات المريض" Visibility="{Binding SelectedPatient, Converter={StaticResource NullToVisibilityConverter}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="كود المريض:" FontWeight="Bold"/>
                        <TextBlock Text="{Binding SelectedPatient.PatientCode}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1">
                        <TextBlock Text="الاسم:" FontWeight="Bold"/>
                        <TextBlock Text="{Binding SelectedPatient.FullName}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="العمر:" FontWeight="Bold"/>
                        <TextBlock Text="{Binding SelectedPatient.Age}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="3">
                        <TextBlock Text="الطبيب:" FontWeight="Bold"/>
                        <TextBlock Text="{Binding SelectedPatient.Doctor.FullName}"/>
                    </StackPanel>
                </Grid>
            </GroupBox>

            <!-- شبكة النتائج -->
            <GroupBox Grid.Row="1" Header="نتائج الفحوصات" Visibility="{Binding SelectedPatient, Converter={StaticResource NullToVisibilityConverter}}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- عناوين الأعمدة -->
                    <Grid Grid.Row="0" Background="#F0F0F0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="60"/>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="80"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="اختصار الفحص" FontWeight="Bold" Margin="5" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="النتيجة" FontWeight="Bold" Margin="5" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="2" Text="الوحدة" FontWeight="Bold" Margin="5" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="3" Text="علامة H-L" FontWeight="Bold" Margin="5" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="4" Text="المعدل الطبيعي" FontWeight="Bold" Margin="5" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="5" Text="انتهاء" FontWeight="Bold" Margin="5" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="6" Text="مراجعة" FontWeight="Bold" Margin="5" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="7" Text="طباعة" FontWeight="Bold" Margin="5" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="8" Text="تصدير" FontWeight="Bold" Margin="5" VerticalAlignment="Center"/>
                    </Grid>

                    <!-- قائمة النتائج -->
                    <ListBox Grid.Row="1" ItemsSource="{Binding TestResults}" 
                             SelectedItem="{Binding SelectedTestResult}"
                             ScrollViewer.HorizontalScrollBarVisibility="Auto">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{Binding BackgroundColor}" BorderBrush="#DDDDDD" BorderThickness="0,0,0,1">
                                    <Grid Height="35">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="80"/>
                                            <ColumnDefinition Width="120"/>
                                            <ColumnDefinition Width="60"/>
                                            <ColumnDefinition Width="80"/>
                                            <ColumnDefinition Width="120"/>
                                            <ColumnDefinition Width="80"/>
                                            <ColumnDefinition Width="80"/>
                                            <ColumnDefinition Width="80"/>
                                            <ColumnDefinition Width="80"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0" Text="{Binding TestAbbreviation}" VerticalAlignment="Center" Margin="5"/>
                                        <TextBox Grid.Column="1" Text="{Binding NumericResult}" VerticalAlignment="Center" Margin="2" Height="25"/>
                                        <TextBlock Grid.Column="2" Text="{Binding TestUnit}" VerticalAlignment="Center" Margin="5"/>
                                        <TextBlock Grid.Column="3" Text="{Binding FlagText}" VerticalAlignment="Center" Margin="5" 
                                                   Foreground="{Binding ForegroundColor}" FontWeight="Bold"/>
                                        <TextBlock Grid.Column="4" Text="{Binding NormalRange}" VerticalAlignment="Center" Margin="5" FontSize="11"/>
                                        <CheckBox Grid.Column="5" IsChecked="{Binding IsCompleted}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                        <CheckBox Grid.Column="6" IsChecked="{Binding IsReviewed}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                        <CheckBox Grid.Column="7" IsChecked="{Binding IsPrinted}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                        <CheckBox Grid.Column="8" IsChecked="{Binding IsExported}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </GroupBox>

            <!-- أزرار العمليات -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,10,0,10"
                        Visibility="{Binding SelectedPatient, Converter={StaticResource NullToVisibilityConverter}}">
                <Button Content="حفظ النتائج" Command="{Binding SaveResultsCommand}" Style="{StaticResource PrimaryButton}"/>
                <Button Content="مراجعة النتيجة" Command="{Binding ReviewResultCommand}" Style="{StaticResource SecondaryButton}"/>
                <Button Content="طباعة" Command="{Binding PrintResultsCommand}" Style="{StaticResource SecondaryButton}"/>
                <Button Content="تصدير" Command="{Binding ExportResultsCommand}" Style="{StaticResource SecondaryButton}"/>
            </StackPanel>

            <!-- قسم التعليقات -->
            <GroupBox Grid.Row="3" Header="التعليقات" Visibility="{Binding SelectedPatient, Converter={StaticResource NullToVisibilityConverter}}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,5,5">
                        <Label Content="التعليقات الجاهزة:"/>
                        <ComboBox ItemsSource="{Binding PredefinedComments}" 
                                  SelectedItem="{Binding SelectedPredefinedComment}"/>
                    </StackPanel>

                    <StackPanel Grid.Row="0" Grid.Column="1" Margin="5,0,0,5">
                        <Label Content="تعليقات الفحص المختار:"/>
                        <TextBox Text="{Binding SelectedTestResult.Comments}" Height="30"/>
                    </StackPanel>

                    <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Margin="0,5,0,0">
                        <Label Content="تعليقات عامة:"/>
                        <TextBox Text="{Binding GeneralComments}" Height="60" 
                                 AcceptsReturn="True" VerticalScrollBarVisibility="Auto" TextWrapping="Wrap"/>
                    </StackPanel>
                </Grid>
            </GroupBox>
        </Grid>

        <!-- شريط الحالة -->
        <Grid Grid.Row="2" Grid.ColumnSpan="2" Background="#F5F5F5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- رسائل الحالة -->
            <StackPanel Grid.Column="0" Margin="10,5">
                <TextBlock Text="{Binding ErrorMessage}" Foreground="Red" 
                           Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibilityConverter}}"/>
                <TextBlock Text="{Binding SuccessMessage}" Foreground="Green" 
                           Visibility="{Binding SuccessMessage, Converter={StaticResource StringToVisibilityConverter}}"/>
            </StackPanel>

            <!-- مؤشر التحميل -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,5"
                        Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}">
                <ProgressBar IsIndeterminate="True" Width="100" Height="20" Margin="0,0,10,0"/>
                <TextBlock Text="جاري المعالجة..." VerticalAlignment="Center"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
