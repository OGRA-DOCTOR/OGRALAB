<Window x:Class="OGRALAB.Views.TestManagementWindow"  
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"  
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"  
        xmlns:converters="clr-namespace:OGRALAB.Converters"  
        xmlns:enums="clr-namespace:OGRALAB.Enums"  
        Title="Test Management - إدارة التحاليل"  
        Height="800" Width="1400"  
        WindowStartupLocation="CenterScreen"  
        ResizeMode="CanResize"  
        Background="#F8F9FA"  
        MinHeight="700" MinWidth="1200">  

    <!-- Ensure EnumToBooleanConverter is defined as a StaticResource -->
    <Window.Resources>
        <converters:EnumToBooleanConverter x:Key="EnumToBooleanConverter"/>
    </Window.Resources>

    <!-- Other code remains unchanged -->

    <StackPanel>
        <RadioButton Content="أكبر من أو يساوي (≥)"  
                     IsChecked="{Binding ReferenceAgeOperator, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=GreaterThanOrEqual}"  
                     Margin="5,2"/>  
        <RadioButton Content="أصغر من أو يساوي (≤)"  
                     IsChecked="{Binding ReferenceAgeOperator, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=LessThanOrEqual}"  
                     Margin="5,2"/>  
        <RadioButton Content="نطاق عمري (من - إلى)"  
                     IsChecked="{Binding ReferenceAgeOperator, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=Range}"  
                     Margin="5,2"/>  
    </StackPanel>  

    <!-- Other code remains unchanged -->

</Window>