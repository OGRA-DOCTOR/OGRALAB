<Window x:Class="OGRALAB.Views.TestManagementWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:OGRALAB.Converters"
        xmlns:enums="clr-namespace:OGRALAB.Enums"
        Title="Test Management - إدارة التحاليل" 
        Height="800" Width="1400"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        Background="#F8F9FA"
        MinHeight="700" MinWidth="1200">

    <Window.Resources>
        <!-- Converters -->
        <converters:EnumToDisplayNameConverter x:Key="EnumToDisplayNameConverter"/>
        <converters:BooleanToArabicTextConverter x:Key="BooleanToArabicTextConverter"/>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <converters:EnumToBooleanConverter x:Key="EnumToBooleanConverter"/>

        <!-- Styles -->
        <Style x:Key="HeaderTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#2C3E50"/>
            <Setter Property="Margin" Value="0,5,0,10"/>
        </Style>

        <Style x:Key="LabelStyle" TargetType="Label">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#34495E"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="TextBoxStyle" TargetType="TextBox">
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="Margin" Value="3"/>
            <Setter Property="BorderBrush" Value="#BDC3C7"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="FontSize" Value="12"/>
            <Style.Triggers>
                <Trigger Property="IsFocused" Value="True">
                    <Setter Property="BorderBrush" Value="#3498DB"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="Margin" Value="3"/>
            <Setter Property="BorderBrush" Value="#BDC3C7"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#27AE60"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Margin" Value="3"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#2ECC71"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#95A5A6"/>
                    <Setter Property="Cursor" Value="Arrow"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#3498DB"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Margin" Value="3"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#5DADE2"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#95A5A6"/>
                    <Setter Property="Cursor" Value="Arrow"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="DangerButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#E74C3C"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Margin" Value="3"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#EC7063"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#95A5A6"/>
                    <Setter Property="Cursor" Value="Arrow"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="DataGridStyle" TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#ECF0F1"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#BDC3C7"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Margin" Value="3"/>
            <Setter Property="FontSize" Value="11"/>
        </Style>

        <Style x:Key="GroupBoxStyle" TargetType="GroupBox">
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="BorderBrush" Value="#BDC3C7"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
        </Style>
    </Window.Resources>

    <Grid>
        <!-- Loading Overlay -->
        <Border Background="#80000000" 
                Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}"
                Panel.ZIndex="999">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <ProgressBar IsIndeterminate="True" Width="100" Height="10" Margin="10"/>
                <TextBlock Text="Loading..." Foreground="White" FontSize="14" HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- Main Content -->
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Grid.Row="0" Background="#34495E" Padding="15">
                <TextBlock Text="إدارة التحاليل والمعدلات الطبيعية - Test &amp; Reference Range Management" 
                          Foreground="White" FontSize="18" FontWeight="Bold"/>
            </Border>

            <!-- Main Content Area -->
            <Grid Grid.Row="1" Margin="5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="5"/>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="5"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>

                <!-- Tests List Section -->
                <GroupBox Grid.Column="0" Header="التحاليل - Tests" Style="{StaticResource GroupBoxStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="2*"/>
                            <RowDefinition Height="5"/>
                            <RowDefinition Height="1*"/>
                        </Grid.RowDefinitions>

                        <!-- Tests Toolbar -->
                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="3">
                            <Button Content="تحديث" Style="{StaticResource SecondaryButtonStyle}"
                                   Command="{Binding RefreshCommand}"/>
                        </StackPanel>

                        <!-- Tests DataGrid -->
                        <DataGrid Grid.Row="1" 
                                 ItemsSource="{Binding Tests}"
                                 SelectedItem="{Binding SelectedTest}"
                                 Style="{StaticResource DataGridStyle}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*"/>
                                <DataGridTextColumn Header="Unit" Binding="{Binding Unit}" Width="80"/>
                                <DataGridTextColumn Header="Price" Binding="{Binding Price, StringFormat='{}{0:F2}'}" Width="80"/>
                                <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="100"/>
                            </DataGrid.Columns>
                        </DataGrid>

                        <!-- Splitter -->
                        <GridSplitter Grid.Row="2" HorizontalAlignment="Stretch" Background="#BDC3C7"/>

                        <!-- Test Form -->
                        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="5">
                                <TextBlock Text="بيانات التحليل - Test Details" Style="{StaticResource HeaderTextStyle}"/>

                                <Label Content="اسم التحليل*:" Style="{StaticResource LabelStyle}"/>
                                <TextBox Text="{Binding TestName, UpdateSourceTrigger=PropertyChanged}" 
                                        Style="{StaticResource TextBoxStyle}"/>

                                <Label Content="الوحدة:" Style="{StaticResource LabelStyle}"/>
                                <TextBox Text="{Binding TestUnit, UpdateSourceTrigger=PropertyChanged}" 
                                        Style="{StaticResource TextBoxStyle}"/>

                                <Label Content="السعر:" Style="{StaticResource LabelStyle}"/>
                                <TextBox Text="{Binding TestPrice, UpdateSourceTrigger=PropertyChanged}" 
                                        Style="{StaticResource TextBoxStyle}"/>

                                <Label Content="الفئة:" Style="{StaticResource LabelStyle}"/>
                                <TextBox Text="{Binding TestCategory, UpdateSourceTrigger=PropertyChanged}" 
                                        Style="{StaticResource TextBoxStyle}"/>

                                <Label Content="الوصف:" Style="{StaticResource LabelStyle}"/>
                                <TextBox Text="{Binding TestDescription, UpdateSourceTrigger=PropertyChanged}" 
                                        Style="{StaticResource TextBoxStyle}" 
                                        TextWrapping="Wrap" AcceptsReturn="True" Height="60"/>

                                <!-- Test Action Buttons -->
                                <StackPanel Margin="0,10,0,0">
                                    <Button Content="إضافة تحليل" Style="{StaticResource PrimaryButtonStyle}"
                                           Command="{Binding AddTestCommand}"/>
                                    <Button Content="تحديث التحليل" Style="{StaticResource SecondaryButtonStyle}"
                                           Command="{Binding UpdateTestCommand}"/>
                                    <Button Content="حذف التحليل" Style="{StaticResource DangerButtonStyle}"
                                           Command="{Binding DeleteTestCommand}"/>
                                    <Button Content="مسح النموذج" Style="{StaticResource SecondaryButtonStyle}"
                                           Command="{Binding ClearTestFormCommand}"/>
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </GroupBox>

                <!-- Splitter 1 -->
                <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Background="#BDC3C7"/>

                <!-- Reference Ranges List Section -->
                <GroupBox Grid.Column="2" Header="المعدلات الطبيعية - Reference Ranges" Style="{StaticResource GroupBoxStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Reference Ranges Toolbar -->
                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="3">
                            <Button Content="تحديث" Style="{StaticResource SecondaryButtonStyle}"
                                   Command="{Binding LoadReferenceRangesCommand}"/>
                            <TextBlock Text="{Binding SelectedTest.Name, StringFormat='للتحليل: {0}'}" 
                                      VerticalAlignment="Center" Margin="10,0" FontWeight="Bold" Foreground="#2C3E50"/>
                        </StackPanel>

                        <!-- Reference Ranges DataGrid -->
                        <DataGrid Grid.Row="1" 
                                 ItemsSource="{Binding ReferenceRanges}"
                                 SelectedItem="{Binding SelectedReferenceRange}"
                                 Style="{StaticResource DataGridStyle}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Gender" 
                                                   Binding="{Binding Gender, Converter={StaticResource EnumToDisplayNameConverter}}" 
                                                   Width="70"/>
                                <DataGridTextColumn Header="Age Condition" Binding="{Binding AgeDescription}" Width="120"/>
                                <DataGridTextColumn Header="Reference Value" Binding="{Binding ReferenceValue}" Width="*"/>
                                <DataGridTextColumn Header="Notes" Binding="{Binding Notes}" Width="100"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </GroupBox>

                <!-- Splitter 2 -->
                <GridSplitter Grid.Column="3" HorizontalAlignment="Stretch" Background="#BDC3C7"/>

                <!-- Reference Range Form Section -->
                <GroupBox Grid.Column="4" Header="بيانات المعدل الطبيعي - Reference Range Details" Style="{StaticResource GroupBoxStyle}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="5">
                            <TextBlock Text="شروط المعدل الطبيعي" Style="{StaticResource HeaderTextStyle}"/>

                            <!-- Gender Selection -->
                            <Label Content="الجنس - Gender:" Style="{StaticResource LabelStyle}"/>
                            <ComboBox ItemsSource="{Binding GenderValues}"
                                     SelectedItem="{Binding ReferenceGender}"
                                     Style="{StaticResource ComboBoxStyle}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Converter={StaticResource EnumToDisplayNameConverter}}"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>

                            <!-- Age Operator Selection -->
                            <Label Content="نوع مقارنة العمر:" Style="{StaticResource LabelStyle}"/>
                            <StackPanel>
                                <RadioButton Content="أكبر من أو يساوي (≥)" 
                                           IsChecked="{Binding ReferenceAgeOperator, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter={x:Static enums:AgeOperator.GreaterThanOrEqual}}"
                                           Margin="5,2"/>
                                <RadioButton Content="أصغر من أو يساوي (≤)" 
                                           IsChecked="{Binding ReferenceAgeOperator, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter={x:Static enums:AgeOperator.LessThanOrEqual}}"
                                           Margin="5,2"/>
                                <RadioButton Content="يساوي (=)" 
                                           IsChecked="{Binding ReferenceAgeOperator, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter={x:Static enums:AgeOperator.Equal}}"
                                           Margin="5,2"/>
                                <RadioButton Content="نطاق عمري (من - إلى)" 
                                           IsChecked="{Binding ReferenceAgeOperator, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter={x:Static enums:AgeOperator.Range}}"
                                           Margin="5,2"/>
                            </StackPanel>

                            <!-- Age Values -->
                            <Label Content="العمر الأول (بالسنوات)*:" Style="{StaticResource LabelStyle}"/>
                            <TextBox Text="{Binding ReferenceAgeValue1, UpdateSourceTrigger=PropertyChanged}" 
                                    Style="{StaticResource TextBoxStyle}"/>

                            <Label Content="العمر الثاني (للنطاق فقط):" Style="{StaticResource LabelStyle}"
                                  Visibility="{Binding RequiresSecondAge, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                            <TextBox Text="{Binding ReferenceAgeValue2, UpdateSourceTrigger=PropertyChanged}" 
                                    Style="{StaticResource TextBoxStyle}"
                                    Visibility="{Binding RequiresSecondAge, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                            <!-- Reference Value -->
                            <Separator Margin="0,10"/>
                            <TextBlock Text="القيمة المرجعية" Style="{StaticResource HeaderTextStyle}"/>

                            <Label Content="القيمة المرجعية*:" Style="{StaticResource LabelStyle}"/>
                            <TextBox Text="{Binding ReferenceValue, UpdateSourceTrigger=PropertyChanged}" 
                                    Style="{StaticResource TextBoxStyle}"
                                    TextWrapping="Wrap" AcceptsReturn="True" Height="60"/>

                            <Label Content="ملاحظات:" Style="{StaticResource LabelStyle}"/>
                            <TextBox Text="{Binding ReferenceNotes, UpdateSourceTrigger=PropertyChanged}" 
                                    Style="{StaticResource TextBoxStyle}"
                                    TextWrapping="Wrap" AcceptsReturn="True" Height="60"/>

                            <!-- Reference Range Action Buttons -->
                            <StackPanel Margin="0,15,0,0">
                                <Button Content="إضافة معدل طبيعي" Style="{StaticResource PrimaryButtonStyle}"
                                       Command="{Binding AddReferenceRangeCommand}"/>
                                <Button Content="تحديث المعدل" Style="{StaticResource SecondaryButtonStyle}"
                                       Command="{Binding UpdateReferenceRangeCommand}"/>
                                <Button Content="حذف المعدل" Style="{StaticResource DangerButtonStyle}"
                                       Command="{Binding DeleteReferenceRangeCommand}"/>
                                <Button Content="مسح النموذج" Style="{StaticResource SecondaryButtonStyle}"
                                       Command="{Binding ClearReferenceFormCommand}"/>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </GroupBox>
            </Grid>

            <!-- Status Bar -->
            <Border Grid.Row="2" Background="#ECF0F1" Padding="10" 
                   Visibility="{Binding StatusMessage, Converter={StaticResource BooleanToVisibilityConverter}}">
                <TextBlock Text="{Binding StatusMessage}" 
                          Foreground="#2C3E50" FontSize="12"/>
            </Border>

            <!-- Bottom Buttons -->
            <Border Grid.Row="3" Background="#F8F9FA" Padding="10">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="إغلاق - Close" 
                           Style="{StaticResource SecondaryButtonStyle}"
                           Command="{Binding CloseCommand}"/>
                </StackPanel>
            </Border>

        </Grid>
    </Grid>
</Window>